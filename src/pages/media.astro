---
import Base from "../layouts/Base.astro";
import { getMedia, selectPublished } from "../lib/content";
import { localIsoKey, weekIsoKeysContaining } from "../lib/calendar-grid";
import {
  MEDIA_CHANNELS,
  formatDuration,
  formatRelativeAgo,
  formatTimestampChip,
  mediaCategoryLabel,
  mediaChannelById,
  sentimentLabel,
  youtubeEmbedUrl,
  youtubeWatchUrl,
} from "../lib/media-channels";
import "../styles/media-terminal.css";

export const prerender = false;

const items = selectPublished(await getMedia())
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());

const categoryOptions = [...new Set(items.map((m) => m.data.category))].sort();
const channelOptions = [...new Set(items.map((m) => m.data.channel))];

const rawCategories = [...new Set(Astro.url.searchParams.getAll("category"))];
const rawChannels = [...new Set(Astro.url.searchParams.getAll("channel"))];
const impactOnly = Astro.url.searchParams.get("impact") === "high";
const dayParam = Astro.url.searchParams.get("day")?.trim() ?? "";

const activeCategories = rawCategories.filter((c) =>
  categoryOptions.includes(c as (typeof categoryOptions)[number]),
);
const activeChannels = rawChannels.filter((c) =>
  channelOptions.includes(c as (typeof channelOptions)[number]),
);

const today = new Date();
const todayKey = localIsoKey(today.getFullYear(), today.getMonth(), today.getDate());
const weekKeyList = weekIsoKeysContaining(todayKey);

function dayKey(d: Date): string {
  return localIsoKey(d.getFullYear(), d.getMonth(), d.getDate());
}

const availableDays = [...new Set(items.map((m) => dayKey(m.data.publishedAt)))].sort((a, b) =>
  b.localeCompare(a),
);

const selectedDay =
  dayParam && /^\d{4}-\d{2}-\d{2}$/.test(dayParam)
    ? dayParam
    : availableDays[0] ?? todayKey;

const filtered = items.filter((m) => {
  if (activeCategories.length > 0 && !activeCategories.includes(m.data.category)) return false;
  if (activeChannels.length > 0 && !activeChannels.includes(m.data.channel)) return false;
  if (impactOnly && m.data.impact !== "high") return false;
  return true;
});

const dayItems = filtered.filter((m) => dayKey(m.data.publishedAt) === selectedDay);
const pool = dayItems.length > 0 ? dayItems : filtered;

const highInPool = pool.filter((m) => m.data.impact === "high");
const highFallback = filtered.filter((m) => m.data.impact === "high");
const mustWatch = (highInPool.length > 0 ? highInPool : highFallback).slice(0, 2);
const mustWatchIds = new Set(mustWatch.map((m) => m.id));
const tapeItems = (dayItems.length > 0 ? dayItems : filtered)
  .filter((m) => !mustWatchIds.has(m.id))
  .slice(0, 24);

/** 당일(선택일) 센티먼트 컨센서스 */
const sentimentPool = (dayItems.length > 0 ? dayItems : pool).filter((m) => m.data.marketSentiment);
const hawk = sentimentPool.filter((m) => m.data.marketSentiment === "hawkish").length;
const dove = sentimentPool.filter((m) => m.data.marketSentiment === "dovish").length;
const mixed = sentimentPool.filter(
  (m) => m.data.marketSentiment === "mixed" || m.data.marketSentiment === "neutral",
).length;
const sentimentTotal = hawk + dove + mixed;
const hawkPct = sentimentTotal > 0 ? Math.round((hawk / sentimentTotal) * 100) : 0;
const dovePct = sentimentTotal > 0 ? Math.round((dove / sentimentTotal) * 100) : 0;
const consensusLead =
  sentimentTotal === 0
    ? "큐레이션 센티먼트 없음"
    : hawk > dove
      ? "신중론·매파 우세"
      : dove > hawk
        ? "완화·비둘기 우세"
        : "혼조·관망";

const channelStats = MEDIA_CHANNELS.map((ch) => {
  const channelItems = items.filter((m) => m.data.channel === ch.id);
  const latest = channelItems[0];
  const isLive = channelItems.some((m) => m.data.live === true);
  const isNew = latest
    ? today.getTime() - latest.data.publishedAt.getTime() < 1000 * 60 * 60 * 36
    : false;
  return { ch, latest, isLive, isNew };
});

const baseUrl = import.meta.env.BASE_URL;
const rootPath = baseUrl.endsWith("/") ? baseUrl : `${baseUrl}/`;

function mediaHref(next: {
  categories?: string[];
  channels?: string[];
  impactHigh?: boolean;
  day?: string;
} = {}) {
  const params = new URLSearchParams();
  const cats = next.categories ?? activeCategories;
  const chans = next.channels ?? activeChannels;
  const high = next.impactHigh ?? impactOnly;
  const day = next.day ?? selectedDay;
  for (const c of cats) params.append("category", c);
  for (const c of chans) params.append("channel", c);
  if (high) params.set("impact", "high");
  if (day) params.set("day", day);
  const qs = params.toString();
  return qs ? `${rootPath}media?${qs}` : `${rootPath}media`;
}

function toggleList(list: string[], id: string): string[] {
  const s = new Set(list);
  if (s.has(id)) s.delete(id);
  else s.add(id);
  return [...s];
}

function dayCellLabel(isoKey: string): string {
  const [, , d] = isoKey.split("-").map(Number);
  return String(d);
}

function formatTapeTime(d: Date): string {
  return d.toLocaleTimeString("ko-KR", {
    timeZone: "Asia/Seoul",
    hour: "2-digit",
    minute: "2-digit",
    hour12: false,
  });
}

function formatTapeDate(d: Date): string {
  return d.toLocaleDateString("ko-KR", {
    timeZone: "Asia/Seoul",
    month: "2-digit",
    day: "2-digit",
  });
}

function formatDayShort(isoKey: string): string {
  const [y, m, d] = isoKey.split("-").map(Number);
  const date = new Date(y!, m! - 1, d!);
  return date.toLocaleDateString("ko-KR", { month: "short", day: "numeric", weekday: "short" });
}

const hasFilters = activeCategories.length > 0 || activeChannels.length > 0 || impactOnly;

const weekPulse = weekKeyList.map((isoKey) => {
  const count = items.filter((m) => dayKey(m.data.publishedAt) === isoKey).length;
  return {
    isoKey,
    dayNum: dayCellLabel(isoKey),
    count,
    isToday: isoKey === todayKey,
    isSelected: isoKey === selectedDay,
    hasContent: count > 0 || availableDays.includes(isoKey),
  };
});
---

<Base
  shell="terminal"
  title="미디어 모니터 | 내 곁에 지인"
  description="경제·증시 유튜브 큐레이션 모니터. High 브리프, 테이프, 워치리스트. 투자 권유가 아닙니다."
>
  <div class="media-shell">
    {/* Filter & sentiment strip */}
    <section
      class="media-panel media-filter flex flex-col gap-2.5 border-b-0 px-3 py-2.5 sm:px-4"
      aria-label="필터 및 컨센서스"
    >
      <div class="flex flex-wrap items-center justify-between gap-2">
        <div class="flex flex-wrap items-center gap-0.5" role="group" aria-label="주간 날짜">
          {
            weekPulse.map((day) => (
              <a
                href={mediaHref({ day: day.isoKey })}
                class:list={[
                  "media-mono flex h-8 w-8 flex-col items-center justify-center text-[11px] transition",
                  day.isSelected
                    ? "bg-[color-mix(in_oklab,var(--mt-accent)_14%,transparent)] text-[var(--mt-accent)]"
                    : "text-[var(--mt-muted)] hover:text-[var(--mt-text)]",
                  day.isToday && !day.isSelected && "outline outline-1 outline-[var(--mt-border)]",
                ]}
                aria-current={day.isSelected ? "date" : undefined}
              >
                {day.dayNum}
                <span
                  class:list={[
                    "mt-0.5 h-1 w-1 rounded-full",
                    day.count > 0 ? "bg-[var(--mt-accent)]" : "bg-[var(--mt-border)]",
                  ]}
                  aria-hidden="true"
                />
              </a>
            ))
          }
        </div>
        <p class="media-mono media-consensus text-[11px] text-[var(--mt-text-2)]">
          {formatDayShort(selectedDay)}
          <span class="mx-1.5 text-[var(--mt-muted)]">·</span>
          오늘의 유튜브 컨센서스:{" "}
          <span class="text-[var(--mt-text)]">{consensusLead}</span>
          {
            sentimentTotal > 0 && (
              <span class="text-[var(--mt-muted)]">
                {" "}
                (매파 {hawkPct}% | 비둘기 {dovePct}%)
              </span>
            )
          }
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-1" role="group" aria-label="카테고리 필터">
        <a
          href={mediaHref({ categories: [], channels: [], impactHigh: false })}
          class="media-chip"
          aria-pressed={!hasFilters}
        >
          전체
        </a>
        {
          MEDIA_CHANNELS.filter((ch) => channelOptions.includes(ch.id)).map((ch) => {
            const on = activeChannels.includes(ch.id);
            return (
              <a
                href={mediaHref({ channels: toggleList(activeChannels, ch.id) })}
                class="media-chip"
                aria-pressed={on}
              >
                {ch.name}
              </a>
            );
          })
        }
        {
          categoryOptions.map((cat) => {
            const on = activeCategories.includes(cat);
            return (
              <a
                href={mediaHref({ categories: toggleList(activeCategories, cat) })}
                class="media-chip"
                aria-pressed={on}
              >
                {mediaCategoryLabel(cat)}
              </a>
            );
          })
        }
        <a
          href={mediaHref({ impactHigh: !impactOnly })}
          class:list={["media-chip", impactOnly && "media-chip-high"]}
          aria-pressed={impactOnly}
        >
          High만
        </a>
      </div>
    </section>

    <div class="media-bento">
      {/* Main briefs */}
      <section class="media-panel media-briefs flex flex-col overflow-hidden" aria-label="필수 시청 브리프">
        <div class="flex items-center justify-between border-b border-[var(--mt-border)] px-3 py-2">
          <h2 class="media-panel-label">Must-Watch Briefs</h2>
          <span class="media-mono text-[10px] text-[var(--mt-muted)]">2-COL</span>
        </div>
        {
          mustWatch.length === 0 ? (
            <p class="p-4 text-sm text-[var(--mt-text-2)]">선택일에 High 브리프가 없습니다.</p>
          ) : (
            <ul class="grid min-h-0 flex-1 gap-0 overflow-auto lg:grid-cols-2">
              {mustWatch.map((item, index) => {
                const ch = mediaChannelById(item.data.channel);
                const bullets =
                  item.data.summaryBullets.length > 0
                    ? item.data.summaryBullets.slice(0, 3)
                    : [item.data.why];
                const stamps = item.data.timestamps.slice(0, 4);
                const frameId = `brief-player-${index}`;
                const embedSrc = youtubeEmbedUrl(item.data.youtubeId);
                return (
                  <li class="flex flex-col border-b border-[var(--mt-border)] p-3 last:border-b-0 lg:border-r lg:border-b-0 lg:[&:nth-child(2n)]:border-r-0">
                    <div class="flex flex-wrap items-center gap-1.5 media-mono text-[10px] text-[var(--mt-text-2)]">
                      <span class="font-semibold text-[var(--mt-bull)]">HIGH</span>
                      <span class="text-[var(--mt-muted)]">·</span>
                      <span>{ch?.name}</span>
                      {item.data.durationSec != null && (
                        <>
                          <span class="text-[var(--mt-muted)]">·</span>
                          <span>{formatDuration(item.data.durationSec)}</span>
                        </>
                      )}
                      {item.data.marketSentiment && (
                        <>
                          <span class="text-[var(--mt-muted)]">·</span>
                          <span>{sentimentLabel(item.data.marketSentiment)}</span>
                        </>
                      )}
                    </div>
                    <h3 class="mt-2 text-[15px] font-semibold leading-snug tracking-[-0.02em] text-[var(--mt-text)]">
                      {item.data.title}
                    </h3>
                    <div class="media-brief-player mt-2.5 aspect-video w-full shrink-0 overflow-hidden bg-black">
                      <iframe
                        id={frameId}
                        title={`${item.data.title} 플레이어`}
                        src={embedSrc}
                        class="h-full w-full"
                        loading={index === 0 ? "eager" : "lazy"}
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                        referrerpolicy="strict-origin-when-cross-origin"
                        allowfullscreen
                      />
                    </div>
                    <ul class="mt-2.5 space-y-1.5 text-[13px] leading-snug text-[var(--mt-text-2)]">
                      {bullets.map((b) => (
                        <li class="flex gap-2">
                          <span class="mt-1.5 h-1 w-1 shrink-0 rounded-full bg-[var(--mt-accent)]" aria-hidden="true" />
                          <span>{b}</span>
                        </li>
                      ))}
                    </ul>
                    {
                      stamps.length > 0 && (
                        <div class="mt-3 flex flex-wrap gap-1.5">
                          {stamps.map((ts) => (
                            <button
                              type="button"
                              class="media-chip"
                              data-brief-frame={frameId}
                              data-brief-seek={item.data.youtubeId}
                              data-media-start={ts.timeSeconds}
                            >
                              {formatTimestampChip(ts.timeSeconds)} {ts.label}
                            </button>
                          ))}
                        </div>
                      )
                    }
                    <div class="mt-3 flex flex-wrap gap-2">
                      <a
                        href={youtubeWatchUrl(item.data.youtubeId)}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="media-chip"
                      >
                        YouTube ↗
                      </a>
                    </div>
                  </li>
                );
              })}
            </ul>
          )
        }
      </section>

      {/* Watchlist */}
      <aside class="media-panel media-watch flex flex-col overflow-hidden" aria-label="채널 워치리스트">
        <div class="flex items-center justify-between border-b border-[var(--mt-border)] px-3 py-2">
          <h2 class="media-panel-label">Watchlist</h2>
          <span class="media-mono text-[10px] text-[var(--mt-muted)]">{MEDIA_CHANNELS.length}</span>
        </div>
        <ul class="min-h-0 flex-1 overflow-y-auto overflow-x-hidden">
          {
            channelStats.map(({ ch, latest, isLive, isNew }) => {
              const on = activeChannels.includes(ch.id);
              return (
                <li class="min-w-0 border-b border-[var(--mt-border)] last:border-b-0">
                  <a
                    href={mediaHref({ channels: on ? [] : [ch.id] })}
                    class:list={[
                      "block min-w-0 overflow-hidden px-3 py-2.5 transition hover:bg-[color-mix(in_oklab,var(--mt-accent)_6%,transparent)]",
                      on && "bg-[color-mix(in_oklab,var(--mt-accent)_8%,transparent)]",
                    ]}
                    aria-pressed={on}
                  >
                    <div class="flex min-w-0 items-center justify-between gap-2">
                      <p class="min-w-0 truncate text-[13px] font-semibold text-[var(--mt-text)]">{ch.name}</p>
                      <div class="flex shrink-0 items-center gap-1.5">
                        {isLive && (
                          <span class="inline-flex items-center gap-1 media-mono text-[10px] font-semibold text-[var(--mt-live)]">
                            <span class="media-live-dot" aria-hidden="true" />
                            LIVE
                          </span>
                        )}
                        {!isLive && isNew && (
                          <span class="media-mono text-[10px] font-semibold text-[var(--mt-accent)]">NEW</span>
                        )}
                      </div>
                    </div>
                    <p class="mt-0.5 text-[11px] leading-snug text-[var(--mt-muted)]">{ch.blurb}</p>
                    {
                      latest && (
                        <p class="media-mono mt-1 flex min-w-0 items-baseline gap-1 text-[10px] text-[var(--mt-text-2)]">
                          <span class="shrink-0">{formatRelativeAgo(latest.data.publishedAt, today)}</span>
                          <span class="shrink-0 text-[var(--mt-muted)]">·</span>
                          <span class="min-w-0 truncate" title={latest.data.title}>
                            {latest.data.title}
                          </span>
                        </p>
                      )
                    }
                  </a>
                </li>
              );
            })
          }
        </ul>
      </aside>

      {/* Tape */}
      <section class="media-panel media-tape flex flex-col overflow-hidden" aria-label="실시간 테이프">
        <div class="flex items-center justify-between border-b border-[var(--mt-border)] px-3 py-2">
          <h2 class="media-panel-label">Tape / Time & Sales</h2>
          <span class="media-mono text-[10px] text-[var(--mt-muted)]">{tapeItems.length} rows</span>
        </div>
        <div class="min-h-0 flex-1 overflow-y-auto overflow-x-hidden">
          <table class="w-full table-fixed border-collapse text-left">
            <thead class="sticky top-0 bg-[var(--mt-surface)]">
              <tr class="media-mono text-[10px] uppercase tracking-wide text-[var(--mt-muted)]">
                <th class="w-[3.75rem] border-b border-[var(--mt-border)] px-2 py-1.5 font-medium sm:w-[5rem] sm:px-3">
                  게시
                </th>
                <th class="w-[4.5rem] border-b border-[var(--mt-border)] px-1 py-1.5 font-medium sm:w-[6.5rem] sm:px-2">
                  채널
                </th>
                <th class="border-b border-[var(--mt-border)] px-2 py-1.5 font-medium">제목 / 뷰</th>
                <th class="hidden w-[5.5rem] border-b border-[var(--mt-border)] px-2 py-1.5 font-medium md:table-cell">
                  자산
                </th>
                <th class="w-10 border-b border-[var(--mt-border)] px-1 py-1.5 font-medium text-right sm:w-12">
                  보기
                </th>
              </tr>
            </thead>
            <tbody>
              {
                tapeItems.length === 0 ? (
                  <tr>
                    <td colspan="5" class="px-3 py-6 text-sm text-[var(--mt-text-2)]">
                      테이프에 표시할 항목이 없습니다.
                    </td>
                  </tr>
                ) : (
                  tapeItems.map((item) => {
                    const ch = mediaChannelById(item.data.channel);
                    const oneLine = item.data.summaryBullets[0] ?? item.data.why;
                    const assets = item.data.relatedAssets.slice(0, 3);
                    return (
                      <tr class="media-tape-row border-b border-[var(--mt-border)]/80 hover:bg-[color-mix(in_oklab,var(--mt-accent)_5%,transparent)]">
                        <td class="media-mono whitespace-nowrap px-2 py-2 text-[11px] leading-tight text-[var(--mt-text-2)] sm:px-3">
                          <span class="block">{formatTapeDate(item.data.publishedAt)}</span>
                          <span class="block text-[var(--mt-muted)]">{formatTapeTime(item.data.publishedAt)}</span>
                        </td>
                        <td
                          class="media-mono truncate px-1 py-2 text-[11px] text-[var(--mt-text)] sm:px-2"
                          title={ch?.name ?? item.data.channel}
                        >
                          {ch?.name ?? item.data.channel}
                        </td>
                        <td class="min-w-0 px-2 py-2">
                          <p
                            class="media-tape-title truncate text-[12px] font-medium text-[var(--mt-text)]"
                            title={`${item.data.title} — ${oneLine}`}
                          >
                            {item.data.title}
                          </p>
                          <p class="truncate text-[11px] text-[var(--mt-muted)]" title={oneLine}>
                            {oneLine}
                          </p>
                        </td>
                        <td class="hidden px-2 py-2 md:table-cell">
                          <div class="flex flex-wrap gap-1 overflow-hidden">
                            {assets.map((a) => (
                              <span class="media-mono text-[10px] text-[var(--mt-accent)]">{a}</span>
                            ))}
                          </div>
                        </td>
                        <td class="px-1 py-2 text-right">
                          <button
                            type="button"
                            class="media-chip !px-2 !py-1"
                            data-media-play={item.data.youtubeId}
                            data-media-start="0"
                            data-media-title={item.data.title}
                          >
                            ▶
                          </button>
                        </td>
                      </tr>
                    );
                  })
                )
              }
            </tbody>
          </table>
        </div>
      </section>
    </div>
  </div>

  <dialog id="media-player-modal" class="media-modal rounded-none shadow-2xl">
    <div class="flex items-center justify-between border-b border-[var(--mt-border)] px-3 py-2">
      <p id="media-player-title" class="truncate pr-3 text-[13px] font-medium text-[var(--mt-text)]"></p>
      <button type="button" id="media-player-close" class="media-chip" aria-label="닫기">
        닫기
      </button>
    </div>
    <div class="aspect-video w-full bg-black">
      <iframe
        id="media-player-frame"
        title="YouTube 인라인 플레이어"
        class="h-full w-full"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen
      ></iframe>
    </div>
  </dialog>

  <script is:inline>
    (function () {
      function embedUrl(id, start, autoplay) {
        var params = "rel=0&modestbranding=1&playsinline=1";
        if (autoplay) params += "&autoplay=1";
        var startSec = Number(start) || 0;
        if (startSec > 0) params += "&start=" + Math.floor(startSec);
        return "https://www.youtube.com/embed/" + encodeURIComponent(id) + "?" + params;
      }

      function wire() {
        document.querySelectorAll("[data-brief-seek]").forEach(function (el) {
          if (!(el instanceof HTMLElement)) return;
          el.onclick = function (e) {
            e.preventDefault();
            var yt = el.getAttribute("data-brief-seek");
            var frameId = el.getAttribute("data-brief-frame");
            if (!yt || !frameId) return;
            var frame = document.getElementById(frameId);
            if (!(frame instanceof HTMLIFrameElement)) return;
            frame.src = embedUrl(yt, el.getAttribute("data-media-start") || "0", true);
          };
        });

        var modal = document.getElementById("media-player-modal");
        var frame = document.getElementById("media-player-frame");
        var titleEl = document.getElementById("media-player-title");
        var closeBtn = document.getElementById("media-player-close");
        if (!(modal instanceof HTMLDialogElement) || !(frame instanceof HTMLIFrameElement)) return;

        function openPlayer(id, start, title) {
          frame.src = embedUrl(id, start, true);
          if (titleEl) titleEl.textContent = title || "";
          if (!modal.open) modal.showModal();
        }

        function closePlayer() {
          frame.src = "";
          if (modal.open) modal.close();
        }

        document.querySelectorAll("[data-media-play]").forEach(function (el) {
          if (!(el instanceof HTMLElement)) return;
          el.onclick = function (e) {
            e.preventDefault();
            var id = el.getAttribute("data-media-play");
            if (!id) return;
            openPlayer(id, el.getAttribute("data-media-start") || "0", el.getAttribute("data-media-title") || "");
          };
        });

        if (closeBtn instanceof HTMLButtonElement) {
          closeBtn.onclick = closePlayer;
        }
        modal.onclose = function () {
          frame.src = "";
        };
        modal.onclick = function (e) {
          if (e.target === modal) closePlayer();
        };
      }

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", wire, { once: true });
      } else {
        wire();
      }
      document.addEventListener("astro:page-load", wire);
    })();
  </script>
