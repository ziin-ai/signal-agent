---
import Base from "../layouts/Base.astro";
import { getEvents, getPublishedPosts } from "../lib/content";
import Panel from "../components/ui/Panel.astro";
import MonthCalendar from "../components/timeline/MonthCalendar.astro";
import DayEventList from "../components/timeline/DayEventList.astro";
import { buildGlobalTimelineEvents, buildSymbolTimelineEvents } from "../lib/timeline";
import { buildGregorianMonthGrid, localIsoKey, shiftMonth } from "../lib/calendar-grid";
import {
  buildSymbolSearchEntries,
  resolveSymbolFromQuery,
} from "../lib/symbol-search";

export const prerender = false;

const posts = await getPublishedPosts();
const externalEvents = await getEvents();

const publishedPosts = [...posts].sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const symbolSearchEntries = buildSymbolSearchEntries(publishedPosts, externalEvents);

const rawSymbol = Astro.url.searchParams.get("symbol")?.trim() ?? "";
const resolvedSymbol = resolveSymbolFromQuery(rawSymbol, symbolSearchEntries);
const exactTickerKnown =
  rawSymbol !== "" &&
  (publishedPosts.some((p) => p.data.symbol === rawSymbol) ||
    externalEvents.some((e) => e.data.symbol === rawSymbol));
const activeSymbol = resolvedSymbol ?? (exactTickerKnown ? rawSymbol : "");
const symbolPosts = activeSymbol ? publishedPosts.filter((p) => p.data.symbol === activeSymbol) : [];
const activeMarket = symbolPosts[0]?.data.market;

const events = activeSymbol
  ? buildSymbolTimelineEvents(activeSymbol, publishedPosts, externalEvents, activeMarket)
  : buildGlobalTimelineEvents(publishedPosts, externalEvents);

const categoryOptions = [...new Set(externalEvents.map((e) => e.data.category))].sort();

const rawKinds = [...new Set(Astro.url.searchParams.getAll("kind"))];
const rawCategories = [...new Set(Astro.url.searchParams.getAll("category"))];
const selectedImpacts = [...new Set(Astro.url.searchParams.getAll("impact"))].filter(
  (k): k is "high" | "mid" | "low" => k === "high" || k === "mid" || k === "low",
);

const hasExplicitFilters =
  rawKinds.length > 0 || rawCategories.length > 0 || selectedImpacts.length > 0;

/** 분석글 on/off. kind 파라미터가 없으면 ON */
const includePosts = rawKinds.length === 0 ? true : rawKinds.includes("post");

/**
 * 이벤트 하위 종류. category 파라미터가 없으면 전부 ON.
 * category=none → 전부 OFF.
 */
const activeCategories =
  rawCategories.length === 0
    ? [...categoryOptions]
    : rawCategories.filter((c) => c !== "none" && categoryOptions.includes(c));

const filteredEvents = events.filter((ev) => {
  if (ev.kind === "post") return includePosts;
  if (ev.kind !== "external_event") return false;
  if (activeCategories.length === 0) return false;
  if (!ev.meta?.category || !activeCategories.includes(ev.meta.category)) return false;
  if (selectedImpacts.length > 0) {
    if (!ev.meta?.impact || !selectedImpacts.includes(ev.meta.impact)) return false;
  }
  return true;
});

const monthParam = Astro.url.searchParams.get("month")?.trim() ?? "";
const dayParam = Astro.url.searchParams.get("day")?.trim() ?? "";
const today = new Date();
let viewYear = today.getFullYear();
let viewMonth = today.getMonth() + 1;
if (/^\d{4}-\d{2}$/.test(monthParam)) {
  const [y, m] = monthParam.split("-").map(Number);
  if (y >= 1970 && y <= 2100 && m >= 1 && m <= 12) {
    viewYear = y;
    viewMonth = m;
  }
}

function eventDayKey(at: string): string {
  const d = new Date(at);
  return localIsoKey(d.getFullYear(), d.getMonth(), d.getDate());
}

const eventsByDay = new Map<string, typeof filteredEvents>();
for (const ev of filteredEvents) {
  const k = eventDayKey(ev.at);
  const list = eventsByDay.get(k) ?? [];
  list.push(ev);
  eventsByDay.set(k, list);
}
for (const [, list] of eventsByDay) {
  list.sort((a, b) => new Date(a.at).getTime() - new Date(b.at).getTime());
}

const eventsInCalendarMonth = filteredEvents.filter((ev) => {
  const d = new Date(ev.at);
  return d.getFullYear() === viewYear && d.getMonth() + 1 === viewMonth;
});

const monthGrid = buildGregorianMonthGrid(viewYear, viewMonth);
const prevNav = shiftMonth(viewYear, viewMonth, -1);
const nextNav = shiftMonth(viewYear, viewMonth, 1);
const prevMonthStr = `${prevNav.year}-${String(prevNav.month).padStart(2, "0")}`;
const nextMonthStr = `${nextNav.year}-${String(nextNav.month).padStart(2, "0")}`;
const todayMonthStr = `${today.getFullYear()}-${String(today.getMonth() + 1).padStart(2, "0")}`;
const todayDayKey = localIsoKey(today.getFullYear(), today.getMonth(), today.getDate());
const monthQueryValue = `${viewYear}-${String(viewMonth).padStart(2, "0")}`;
const firstOfMonthKey = localIsoKey(viewYear, viewMonth - 1, 1);
const todayInViewMonth = today.getFullYear() === viewYear && today.getMonth() + 1 === viewMonth;
const defaultDayKey = todayInViewMonth ? todayDayKey : firstOfMonthKey;

const selectedDayKey =
  /^\d{4}-\d{2}-\d{2}$/.test(dayParam) && dayParam.startsWith(monthQueryValue)
    ? dayParam
    : /^\d{4}-\d{2}-\d{2}$/.test(dayParam)
      ? dayParam
      : defaultDayKey;

const selectedDayEvents = eventsByDay.get(selectedDayKey) ?? [];

const baseUrl = import.meta.env.BASE_URL;
const rootPath = baseUrl.endsWith("/") ? baseUrl : `${baseUrl}/`;

function timelineHref(next: {
  symbol?: string | null;
  includePosts?: boolean;
  categories?: string[];
  impacts?: string[];
  /** 필터를 URL에 기록. false면 기본(전체) URL */
  writeFilters?: boolean;
  month?: string;
  day?: string | null;
}) {
  const params = new URLSearchParams();
  const symbolValue = next.symbol !== undefined ? next.symbol : activeSymbol;
  const postsValue = next.includePosts ?? includePosts;
  const categoriesValue = next.categories ?? activeCategories;
  const impactsValue = next.impacts !== undefined ? next.impacts : selectedImpacts;
  const writeFilters = next.writeFilters ?? hasExplicitFilters;
  const monthValue = next.month ?? monthQueryValue;
  const dayValue = next.day !== undefined ? next.day : selectedDayKey;
  if (symbolValue) params.set("symbol", symbolValue);
  if (writeFilters) {
    if (postsValue) params.append("kind", "post");
    if (categoriesValue.length === 0) {
      params.append("category", "none");
      if (!postsValue) params.append("kind", "none");
    } else {
      for (const c of categoriesValue) params.append("category", c);
    }
    for (const i of impactsValue) params.append("impact", i);
  }
  params.set("month", monthValue);
  if (dayValue) params.set("day", dayValue);
  const qs = params.toString();
  return qs ? `${rootPath}?${qs}` : rootPath;
}

/**
 * 영향도: 빈 배열 = 전체 ON.
 * 클릭 시 실제 켜진 집합을 기준으로 토글하고, 전부 켜지면 다시 []로 정규화한다.
 */
function toggleAxis(selected: string[], id: string, allIds: readonly string[]): string[] {
  const on = new Set(selected.length === 0 ? allIds : selected);
  if (on.has(id)) on.delete(id);
  else on.add(id);
  if (on.size === 0 || allIds.every((x) => on.has(x))) return [];
  return allIds.filter((x) => on.has(x));
}

function toggleListMember(list: string[], id: string): string[] {
  const s = new Set(list);
  if (s.has(id)) s.delete(id);
  else s.add(id);
  return [...s];
}

/** 영향도: 선택 없음 = 전체 ON */
function axisOn(selected: string[], id: string): boolean {
  return selected.length === 0 || selected.includes(id);
}

const IMPACT_ALL = ["high", "mid", "low"] as const;

function filterTabClass(active: boolean, tone: "default" | "post" | "event" = "default"): string {
  const base =
    "inline-flex items-center gap-1 rounded-md3-sm px-2.5 py-1 text-[12px] font-medium transition";
  if (!active) {
    return `${base} text-on-surface-variant/45 line-through decoration-on-surface-variant/35 hover:bg-surface-container hover:text-on-surface-variant hover:no-underline`;
  }
  if (tone === "post") {
    return `${base} bg-sky-100 font-semibold text-sky-800 dark:bg-sky-950/55 dark:text-sky-100`;
  }
  if (tone === "event") {
    return `${base} bg-orange-100 font-semibold text-orange-900 dark:bg-orange-950/50 dark:text-orange-100`;
  }
  return `${base} bg-primary/12 font-semibold text-primary`;
}

function categoryLabel(category: string) {
  if (category === "macro") return "매크로";
  if (category === "earnings") return "실적";
  if (category === "product") return "제품";
  if (category === "policy") return "정책";
  if (category === "supply-chain") return "공급망";
  if (category === "news") return "뉴스";
  return "기타";
}

const filterResetHref = timelineHref({
  includePosts: true,
  categories: [...categoryOptions],
  impacts: [],
  writeFilters: false,
  day: selectedDayKey,
});
---

<Base
  title={activeSymbol ? `캘린더 · ${activeSymbol} | 내 곁에 지인` : "캘린더 | 내 곁에 지인"}
  description={
    activeSymbol
      ? `${activeSymbol} 관련 분석글/외부 이벤트 일정을 달력형 타임라인으로 제공합니다.`
      : "분석글과 외부 이벤트를 월 단위 달력으로 보는 메인 캘린더."
  }
>
  <section
    class="mb-3 flex flex-wrap items-center gap-x-0.5 gap-y-1.5"
    role="group"
    aria-label="일정 필터"
  >
    <a
      href={timelineHref({
        includePosts: !includePosts,
        writeFilters: true,
        day: selectedDayKey,
      })}
      class={filterTabClass(includePosts, "post")}
      aria-pressed={includePosts}
      title={includePosts ? "분석 끄기" : "분석 켜기"}
    >
      분석
    </a>

    <span class="mx-1.5 hidden h-3.5 w-px bg-outline-variant/70 sm:inline-block" aria-hidden="true" />

    {
      categoryOptions.map((category) => {
        const on = activeCategories.includes(category);
        return (
          <a
            href={timelineHref({
              categories: toggleListMember(activeCategories, category),
              writeFilters: true,
              day: selectedDayKey,
            })}
            class={filterTabClass(on, "event")}
            aria-pressed={on}
            title={on ? `${categoryLabel(category)} 끄기` : `${categoryLabel(category)} 켜기`}
          >
            {categoryLabel(category)}
          </a>
        );
      })
    }

    <span class="mx-1.5 hidden h-3.5 w-px bg-outline-variant/70 sm:inline-block" aria-hidden="true" />

    {
      IMPACT_ALL.map((id) => {
        const on = axisOn(selectedImpacts, id);
        return (
          <a
            href={timelineHref({
              impacts: toggleAxis(selectedImpacts, id, IMPACT_ALL),
              writeFilters: true,
              day: selectedDayKey,
            })}
            class={filterTabClass(on)}
            aria-pressed={on}
            title={on ? `${id} 끄기` : `${id} 켜기`}
          >
            {id === "high" ? "High" : id === "mid" ? "Mid" : "Low"}
          </a>
        );
      })
    }

    {
      hasExplicitFilters && (
        <a
          href={filterResetHref}
          class="ml-1 text-[12px] font-medium text-on-surface-variant transition hover:text-primary"
        >
          전체
        </a>
      )
    }
  </section>

  <section class="grid grid-cols-1 gap-4 lg:grid-cols-12">
    <div class="space-y-4 lg:col-span-9">
      <MonthCalendar
        viewYear={viewYear}
        viewMonth={viewMonth}
        monthGrid={monthGrid}
        eventsByDay={eventsByDay}
        todayDayKey={todayDayKey}
        selectedDayKey={selectedDayKey}
        todayHref={timelineHref({ month: todayMonthStr, day: todayDayKey })}
        prevMonthHref={timelineHref({ month: prevMonthStr, day: null })}
        nextMonthHref={timelineHref({ month: nextMonthStr, day: null })}
        dayHref={(isoKey) => timelineHref({ day: isoKey, month: isoKey.slice(0, 7) })}
        eventsInMonthCount={eventsInCalendarMonth.length}
        filteredTotalCount={filteredEvents.length}
        rootPath={rootPath}
      />
    </div>

    <aside class="space-y-4 lg:col-span-3">
      <DayEventList dayKey={selectedDayKey} events={selectedDayEvents} rootPath={rootPath} />

      {
        activeSymbol && symbolPosts.length > 0 && (
          <Panel title="이 종목 분석글">
            <ul class="mt-3 space-y-2">
              {symbolPosts.slice(0, 6).map((post) => (
                <li class="rounded-lg bg-secondary/30 px-3 py-2 text-sm">
                  <a href={`${rootPath}posts/${post.id.replace(/\.md$/, "")}`} class="hover:text-primary">
                    {post.data.title}
                  </a>
                  <p class="mt-0.5 text-[10px] text-on-surface-variant">
                    {post.data.date.toLocaleDateString("ko-KR")} · 확신 {post.data.conviction}/5
                  </p>
                </li>
              ))}
            </ul>
          </Panel>
        )
      }
    </aside>
  </section>
</Base>
