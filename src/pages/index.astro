---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";
import HeroCard from "../components/dashboard/HeroCard.astro";
import TrustCard from "../components/dashboard/TrustCard.astro";
import DashboardTimelineInteractive from "../components/dashboard/DashboardTimelineInteractive";
import {
  buildTimelineEvents,
  buildGlobalTimelineEvents,
} from "../lib/timeline";
import { getThemeIndexChartLines, getYahooChartSeries, isThemeSymbol } from "../lib/market";
import {
  marketCategoryOptionsInWindow,
  resolveDashboardTimelineFilters,
} from "../lib/dashboard-event-filters";

export const prerender = true;

const allPosts = await getCollection("posts");
const posts =
  allPosts.filter((post) => post.data.draft !== true).length > 0
    ? allPosts.filter((post) => post.data.draft !== true)
    : allPosts;
const externalEvents = await getCollection("events");

const publishedPosts = [...posts].sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const latestPost = publishedPosts[0];
const requestedPost = Astro.url.searchParams.get("post");
const activePost = requestedPost
  ? publishedPosts.find((post) => post.id.replace(/\.md$/, "") === requestedPost) ?? latestPost
  : latestPost;
const activeMeta = activePost
  ? {
      slug: activePost.id.replace(/\.md$/, ""),
      title: activePost.data.title,
      market: activePost.data.market,
      tags: activePost.data.tags,
      entities: Object.values(activePost.data.entities).flat(),
    }
  : undefined;
const activeIndex = activePost ? publishedPosts.findIndex((post) => post.id === activePost.id) : -1;
const newerPostSlug =
  activeIndex > 0 ? publishedPosts[activeIndex - 1].id.replace(/\.md$/, "") : undefined;
const olderPostSlug =
  activeIndex >= 0 && activeIndex < publishedPosts.length - 1
    ? publishedPosts[activeIndex + 1].id.replace(/\.md$/, "")
    : undefined;
const relatedPosts = activePost
  ? publishedPosts.filter((post) => {
      const hasSameMarket = post.data.market === activePost.data.market;
      const hasTagOverlap = post.data.tags.some((tag) => activePost.data.tags.includes(tag));
      const hasEntityOverlap = Object.values(post.data.entities)
        .flat()
        .some((entity) => activeMeta?.entities.includes(entity));
      return hasSameMarket || hasTagOverlap || hasEntityOverlap;
    })
  : publishedPosts;
const dashboardBaseEvents =
  activePost && publishedPosts.length > 0
    ? buildTimelineEvents(relatedPosts, activePost, externalEvents)
    : publishedPosts.length > 0
      ? buildGlobalTimelineEvents(publishedPosts, externalEvents)
      : [];
const now = new Date();
const dashboardWindowStart = new Date(now);
dashboardWindowStart.setMonth(dashboardWindowStart.getMonth() - 8);
dashboardWindowStart.setHours(0, 0, 0, 0);
const dashboardWindowEnd = new Date(now);
dashboardWindowEnd.setMonth(dashboardWindowEnd.getMonth() + 4);
dashboardWindowEnd.setHours(23, 59, 59, 999);
const dashboardSpan = Math.max(1, dashboardWindowEnd.getTime() - dashboardWindowStart.getTime());
const dashboardTodayPct = Math.min(
  100,
  Math.max(0, ((now.getTime() - dashboardWindowStart.getTime()) / dashboardSpan) * 100),
);
const dashboardEvents = dashboardBaseEvents
  .filter((e) => {
    const t = new Date(e.at).getTime();
    return t >= dashboardWindowStart.getTime() && t <= dashboardWindowEnd.getTime();
  })
  .sort((a, b) => new Date(a.at).getTime() - new Date(b.at).getTime());
const marketCategoryOptions = marketCategoryOptionsInWindow(
  externalEvents,
  dashboardWindowStart,
  dashboardWindowEnd,
);
const baseUrl = import.meta.env.BASE_URL;
const rootPath = baseUrl.endsWith("/") ? baseUrl : `${baseUrl}/`;
const { selectedEventMarket, selectedEventCategories } = resolveDashboardTimelineFilters(
  Astro.url,
  activePost?.data.market,
  externalEvents,
  marketCategoryOptions,
);
const activePostSlug = activePost?.id.replace(/\.md$/, "");
const filterPathAndQuery = `${Astro.url.pathname}${Astro.url.search}${Astro.url.hash}`;
const newerPostHref = newerPostSlug ? `${rootPath}dashboard/${newerPostSlug}` : "#";
const olderPostHref = olderPostSlug ? `${rootPath}dashboard/${olderPostSlug}` : "#";
const activeChartFallbackPoints: Array<{ at: string; price: number }> = [];
let activeChartPoints = [...activeChartFallbackPoints];
let themeChartLines: Awaited<ReturnType<typeof getThemeIndexChartLines>> | undefined;
let priceDataStatusMessage = "";
if (activePost) {
  try {
    if (isThemeSymbol(activePost.data.symbol)) {
      themeChartLines = await getThemeIndexChartLines(activePost.data.market, {
        range: "1y",
        interval: "1d",
      });
      if (!themeChartLines.length) {
        priceDataStatusMessage =
          "지수 일봉을 가져오지 못했습니다. 네트워크 또는 Yahoo Finance 제한일 수 있습니다.";
      }
    } else {
      const { closes, timestamps } = await getYahooChartSeries(activePost.data.symbol, {
        range: "1y",
        interval: "1d",
        market: activePost.data.market,
      });
      if (closes.length === timestamps.length && closes.length > 1) {
        activeChartPoints = closes.map((price, i) => ({
          at: new Date(timestamps[i] * 1000).toISOString(),
          price,
        }));
      } else {
        priceDataStatusMessage =
          activeChartFallbackPoints.length > 1
            ? "외부 시세 응답이 비어 내부 보조 데이터로 표시 중"
            : "외부 시세 응답이 비어 기준선으로 표시 중";
      }
    }
  } catch (error) {
    const msg = error instanceof Error ? error.message : "";
    if (activePost && isThemeSymbol(activePost.data.symbol)) {
      priceDataStatusMessage = `지수 시세 연동 실패(${msg || "network"})`;
    } else {
      priceDataStatusMessage =
        activeChartFallbackPoints.length > 1
          ? `외부 시세 연동 실패(${msg || "network"}) · 내부 보조 데이터로 표시 중`
          : `외부 시세 연동 실패(${msg || "network"}) · 기준선으로 표시 중`;
    }
  }
}
const timelineChartVariant =
  activePost && isThemeSymbol(activePost.data.symbol)
    ? themeChartLines?.length
      ? "theme"
      : "theme-empty"
    : "stock";
const sortedChart = [...activeChartPoints].sort((a, b) => new Date(a.at).getTime() - new Date(b.at).getTime());
const currentPrice =
  themeChartLines?.length && themeChartLines[0]?.points.length
    ? undefined
    : sortedChart.length > 0
      ? sortedChart[sortedChart.length - 1]!.price
      : undefined;
---

<Base
  title="내 곁에 지인 | 개인 증시 블로그"
  description="출처를 붙인 한국·글로벌 증시·매크로 메모와 일정 타임라인을 올리는 개인 블로그. 투자 자문이 아닙니다."
  agentContext={
    activePost
      ? {
          slug: activePost.id.replace(/\.md$/, ""),
          symbol: activePost.data.symbol,
          title: activePost.data.title,
        }
      : undefined
  }
>
  <section
    class="relative z-10 mb-3 md-card md-card-filled px-4 py-3.5"
    aria-label="사이트 소개"
  >
    <p class="text-sm leading-relaxed text-on-surface">
      <strong>지인.ai</strong>는 출처를 붙인 증시·매크로 메모를 올리는 <strong>개인 블로그</strong>입니다. 투자
      권유가 아니며,
      <a href={`${rootPath}about`} class="text-primary hover:underline">소개</a>·
      <a href={`${rootPath}posts`} class="text-primary hover:underline">글 목록</a>에서 본문을 바로 읽을 수 있습니다.
    </p>
    <p class="mt-2 text-xs text-on-surface-variant">
      교육 가이드:
      <a href={`${rootPath}posts/2026-07-28-how-to-read-foreign-investor-flows`} class="text-primary hover:underline">외국인 수급</a>
      ·
      <a href={`${rootPath}posts/2026-07-28-forward-per-valuation-guide`} class="text-primary hover:underline">선행 PER</a>
      ·
      <a href={`${rootPath}posts/2026-07-28-krx-sidecar-circuit-breaker-guide`} class="text-primary hover:underline">사이드카·CB</a>
      ·
      <a href={`${rootPath}posts/2026-07-28-usd-krw-and-korea-equities`} class="text-primary hover:underline">원/달러</a>
      ·
      <a href={`${rootPath}posts/2026-07-28-etf-vs-individual-stocks-krx`} class="text-primary hover:underline">ETF vs 개별주</a>
    </p>
  </section>

  {activePost && (
    <section
      transition:name="dashboard-hero"
      class="relative z-10 grid grid-cols-1 items-stretch gap-4 lg:grid-cols-3"
    >
      <HeroCard post={activePost} />
      <TrustCard post={activePost} />
    </section>
  )}

  {activeMeta && (
    <section transition:name="dashboard-meta" class="relative z-10 mt-2 flex flex-wrap items-center justify-between gap-2">
      <p class="text-xs text-on-surface-variant">
        기준 글: <span class="text-primary">{activeMeta.title}</span>
      </p>
      <div class="flex items-center gap-2 text-xs">
        <a
          href={newerPostHref}
          class={`md-btn-tonal !min-h-8 px-3 text-xs ${
            newerPostSlug ? "" : "pointer-events-none opacity-40"
          }`}
        >
          더 최신 글
        </a>
        <a
          href={olderPostHref}
          class={`md-btn-tonal !min-h-8 px-3 text-xs ${
            olderPostSlug ? "" : "pointer-events-none opacity-40"
          }`}
        >
          이전 글
        </a>
      </div>
    </section>
  )}

  {!latestPost && (
    <section class="rounded-xl border border-slate-300/70 bg-white p-6 dark:border-slate-700/70 dark:bg-slate-900">
      <p class="text-sm text-slate-600 dark:text-slate-300">표시할 published post가 아직 없습니다.</p>
      <p class="mt-2 text-xs text-slate-500 dark:text-slate-400">
        로컬 개발 중이라면 <code class="rounded bg-slate-100 px-1 dark:bg-slate-800">npm run dev</code>를 재시작하거나
        <a href={`${rootPath}posts/`} class="text-info hover:underline">분석글 목록</a>에서 직접 열어보세요.
      </p>
    </section>
  )}

  {publishedPosts.length > 0 && (
    <section class="relative z-20 mt-3 scroll-mt-8" id="recent-flow" aria-label="최근 흐름 타임라인">
      <DashboardTimelineInteractive
        client:load
        key={`${activePost?.id ?? "global"}|${selectedEventMarket}|${selectedEventCategories.join(",")}`}
        allEvents={dashboardEvents}
        windowStart={dashboardWindowStart.toISOString()}
        windowEnd={dashboardWindowEnd.toISOString()}
        todayPct={dashboardTodayPct}
        pricePoints={activeChartPoints}
        themeChartLines={themeChartLines ?? []}
        timelineChartVariant={timelineChartVariant}
        symbol={activePost?.data.symbol}
        market={activePost?.data.market}
        currentPrice={currentPrice}
        priceDataStatusMessage={priceDataStatusMessage}
        rootPath={rootPath}
        filterPathAndQuery={filterPathAndQuery}
        initialMarket={selectedEventMarket}
        initialCategories={selectedEventCategories}
        marketCategoryOptions={marketCategoryOptions}
      />
    </section>
  )}
</Base>
