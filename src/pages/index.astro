---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";
import HeroCompact from "../components/dashboard/HeroCompact.astro";
import MonthCalendar from "../components/timeline/MonthCalendar.astro";
import WeekEventList from "../components/timeline/WeekEventList.astro";
import DashboardTimelineInteractive from "../components/dashboard/DashboardTimelineInteractive";
import { buildTimelineEvents, buildGlobalTimelineEvents } from "../lib/timeline";
import { buildGregorianMonthGrid, localIsoKey, shiftMonth } from "../lib/calendar-grid";
import { getThemeIndexChartLines, getYahooChartSeries, isThemeSymbol } from "../lib/market";
import {
  marketCategoryOptionsInWindow,
  resolveDashboardTimelineFilters,
} from "../lib/dashboard-event-filters";
import {
  filterHomeCalendarEvents,
  HOME_CAL_CATEGORY_OPTIONS,
  homeCalCategoryLabel,
  homeCalChipClass,
  resolveHomeCalendarFilters,
  toggleListMember,
} from "../lib/calendar-filters";

export const prerender = false;

const allPosts = await getCollection("posts");
const posts =
  allPosts.filter((post) => post.data.draft !== true).length > 0
    ? allPosts.filter((post) => post.data.draft !== true)
    : allPosts;
const externalEvents = await getCollection("events");

const publishedPosts = [...posts].sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const latestPost = publishedPosts[0];
const requestedPost = Astro.url.searchParams.get("post");
const activePost = requestedPost
  ? (publishedPosts.find((post) => post.id.replace(/\.md$/, "") === requestedPost) ?? latestPost)
  : latestPost;
const activeMeta = activePost
  ? {
      slug: activePost.id.replace(/\.md$/, ""),
      title: activePost.data.title,
      market: activePost.data.market,
      tags: activePost.data.tags,
      entities: Object.values(activePost.data.entities).flat(),
    }
  : undefined;
const activeIndex = activePost ? publishedPosts.findIndex((post) => post.id === activePost.id) : -1;
const newerPostSlug =
  activeIndex > 0 ? publishedPosts[activeIndex - 1].id.replace(/\.md$/, "") : undefined;
const olderPostSlug =
  activeIndex >= 0 && activeIndex < publishedPosts.length - 1
    ? publishedPosts[activeIndex + 1].id.replace(/\.md$/, "")
    : undefined;
const relatedPosts = activePost
  ? publishedPosts.filter((post) => {
      const hasSameMarket = post.data.market === activePost.data.market;
      const hasTagOverlap = post.data.tags.some((tag) => activePost.data.tags.includes(tag));
      const hasEntityOverlap = Object.values(post.data.entities)
        .flat()
        .some((entity) => activeMeta?.entities.includes(entity));
      return hasSameMarket || hasTagOverlap || hasEntityOverlap;
    })
  : publishedPosts;
const dashboardBaseEvents =
  activePost && publishedPosts.length > 0
    ? buildTimelineEvents(relatedPosts, activePost, externalEvents)
    : publishedPosts.length > 0
      ? buildGlobalTimelineEvents(publishedPosts, externalEvents)
      : [];
const now = new Date();
const dashboardWindowStart = new Date(now);
dashboardWindowStart.setMonth(dashboardWindowStart.getMonth() - 8);
dashboardWindowStart.setHours(0, 0, 0, 0);
const dashboardWindowEnd = new Date(now);
dashboardWindowEnd.setMonth(dashboardWindowEnd.getMonth() + 4);
dashboardWindowEnd.setHours(23, 59, 59, 999);
const dashboardSpan = Math.max(1, dashboardWindowEnd.getTime() - dashboardWindowStart.getTime());
const dashboardTodayPct = Math.min(
  100,
  Math.max(0, ((now.getTime() - dashboardWindowStart.getTime()) / dashboardSpan) * 100),
);
const dashboardEvents = dashboardBaseEvents
  .filter((e) => {
    const t = new Date(e.at).getTime();
    return t >= dashboardWindowStart.getTime() && t <= dashboardWindowEnd.getTime();
  })
  .sort((a, b) => new Date(a.at).getTime() - new Date(b.at).getTime());
const marketCategoryOptions = marketCategoryOptionsInWindow(
  externalEvents,
  dashboardWindowStart,
  dashboardWindowEnd,
);
const baseUrl = import.meta.env.BASE_URL;
const rootPath = baseUrl.endsWith("/") ? baseUrl : `${baseUrl}/`;
const { selectedEventMarket, selectedEventCategories } = resolveDashboardTimelineFilters(
  Astro.url,
  activePost?.data.market,
  externalEvents,
  marketCategoryOptions,
);
const filterPathAndQuery = `${Astro.url.pathname}${Astro.url.search}${Astro.url.hash}`;
const newerPostHref = newerPostSlug ? `${rootPath}dashboard/${newerPostSlug}` : "#";
const olderPostHref = olderPostSlug ? `${rootPath}dashboard/${olderPostSlug}` : "#";
const activeChartFallbackPoints: Array<{ at: string; price: number }> = [];
let activeChartPoints = [...activeChartFallbackPoints];
let themeChartLines: Awaited<ReturnType<typeof getThemeIndexChartLines>> | undefined;
let priceDataStatusMessage = "";
if (activePost) {
  try {
    if (isThemeSymbol(activePost.data.symbol)) {
      themeChartLines = await getThemeIndexChartLines(activePost.data.market, {
        range: "1y",
        interval: "1d",
      });
      if (!themeChartLines.length) {
        priceDataStatusMessage =
          "지수 일봉을 가져오지 못했습니다. 네트워크 또는 Yahoo Finance 제한일 수 있습니다.";
      }
    } else {
      const { closes, timestamps } = await getYahooChartSeries(activePost.data.symbol, {
        range: "1y",
        interval: "1d",
        market: activePost.data.market,
      });
      if (closes.length === timestamps.length && closes.length > 1) {
        activeChartPoints = closes.map((price, i) => ({
          at: new Date(timestamps[i] * 1000).toISOString(),
          price,
        }));
      } else {
        priceDataStatusMessage =
          activeChartFallbackPoints.length > 1
            ? "외부 시세 응답이 비어 내부 보조 데이터로 표시 중"
            : "외부 시세 응답이 비어 기준선으로 표시 중";
      }
    }
  } catch (error) {
    const msg = error instanceof Error ? error.message : "";
    if (activePost && isThemeSymbol(activePost.data.symbol)) {
      priceDataStatusMessage = `지수 시세 연동 실패(${msg || "network"})`;
    } else {
      priceDataStatusMessage =
        activeChartFallbackPoints.length > 1
          ? `외부 시세 연동 실패(${msg || "network"}) · 내부 보조 데이터로 표시 중`
          : `외부 시세 연동 실패(${msg || "network"}) · 기준선으로 표시 중`;
    }
  }
}
const timelineChartVariant =
  activePost && isThemeSymbol(activePost.data.symbol)
    ? themeChartLines?.length
      ? "theme"
      : "theme-empty"
    : "stock";
const sortedChart = [...activeChartPoints].sort((a, b) => new Date(a.at).getTime() - new Date(b.at).getTime());
const currentPrice =
  themeChartLines?.length && themeChartLines[0]?.points.length
    ? undefined
    : sortedChart.length > 0
      ? sortedChart[sortedChart.length - 1]!.price
      : undefined;

/** 홈 캘린더: URL 필터(기본 = 분석글 + High · 실적/매크로) */
const calFilter = resolveHomeCalendarFilters(Astro.url);
const homeCalendarEvents = filterHomeCalendarEvents(
  buildGlobalTimelineEvents(publishedPosts, externalEvents),
  calFilter,
);

const monthParam = Astro.url.searchParams.get("month")?.trim() ?? "";
const dayParam = Astro.url.searchParams.get("day")?.trim() ?? "";
let viewYear = now.getFullYear();
let viewMonth = now.getMonth() + 1;
if (/^\d{4}-\d{2}$/.test(monthParam)) {
  const [y, m] = monthParam.split("-").map(Number);
  if (y >= 1970 && y <= 2100 && m >= 1 && m <= 12) {
    viewYear = y;
    viewMonth = m;
  }
}

function eventDayKey(at: string): string {
  const d = new Date(at);
  return localIsoKey(d.getFullYear(), d.getMonth(), d.getDate());
}

const eventsByDay = new Map<string, typeof homeCalendarEvents>();
for (const ev of homeCalendarEvents) {
  const k = eventDayKey(ev.at);
  const list = eventsByDay.get(k) ?? [];
  list.push(ev);
  eventsByDay.set(k, list);
}
for (const [, list] of eventsByDay) {
  list.sort((a, b) => new Date(a.at).getTime() - new Date(b.at).getTime());
}

const eventsInCalendarMonth = homeCalendarEvents.filter((ev) => {
  const d = new Date(ev.at);
  return d.getFullYear() === viewYear && d.getMonth() + 1 === viewMonth;
});

const monthGrid = buildGregorianMonthGrid(viewYear, viewMonth);
const prevNav = shiftMonth(viewYear, viewMonth, -1);
const nextNav = shiftMonth(viewYear, viewMonth, 1);
const prevMonthStr = `${prevNav.year}-${String(prevNav.month).padStart(2, "0")}`;
const nextMonthStr = `${nextNav.year}-${String(nextNav.month).padStart(2, "0")}`;
const todayMonthStr = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, "0")}`;
const todayDayKey = localIsoKey(now.getFullYear(), now.getMonth(), now.getDate());
const monthQueryValue = `${viewYear}-${String(viewMonth).padStart(2, "0")}`;
const firstOfMonthKey = localIsoKey(viewYear, viewMonth - 1, 1);
const todayInViewMonth = now.getFullYear() === viewYear && now.getMonth() + 1 === viewMonth;
const defaultDayKey = todayInViewMonth ? todayDayKey : firstOfMonthKey;

const selectedDayKey = /^\d{4}-\d{2}-\d{2}$/.test(dayParam) ? dayParam : defaultDayKey;

function homeHref(
  next: {
    month?: string;
    day?: string | null;
    includePosts?: boolean;
    impacts?: string[];
    categories?: string[];
    /** 필터를 URL에 기록 (칩 토글·커스텀 유지). false면 기본 큐레이션 URL(필터 생략) */
    writeFilters?: boolean;
  } = {},
) {
  const params = new URLSearchParams();
  if (requestedPost) params.set("post", requestedPost);
  const monthValue = next.month ?? monthQueryValue;
  const dayValue = next.day !== undefined ? next.day : selectedDayKey;
  params.set("month", monthValue);
  if (dayValue) params.set("day", dayValue);

  const includePosts = next.includePosts ?? calFilter.includePosts;
  const impacts = next.impacts ?? calFilter.impacts;
  const categories = next.categories ?? calFilter.categories;
  const writeFilters = next.writeFilters ?? calFilter.isCustom;

  if (writeFilters) {
    if (includePosts) params.append("kind", "post");
    else params.append("kind", "external_event");
    for (const i of impacts) params.append("impact", i);
    for (const c of categories) params.append("category", c);
  }

  const qs = params.toString();
  return qs ? `${rootPath}?${qs}` : rootPath;
}

const filterResetHref = homeHref({ writeFilters: false });
const highOn = calFilter.impacts.includes("high");
---

<Base
  title="내 곁에 지인 | 개인 증시 블로그"
  description="월 캘린더로 오늘 읽을 분석·핵심 일정을 먼저 보고, 최근 흐름 타임라인으로 이어지는 개인 증시 블로그. 투자 자문이 아닙니다."
  agentContext={
    activePost
      ? {
          slug: activePost.id.replace(/\.md$/, ""),
          symbol: activePost.data.symbol,
          title: activePost.data.title,
        }
      : undefined
  }
>
  <section class="ziin-rise relative z-10" aria-label="월 캘린더">
    <div class="mb-3 flex flex-wrap items-center justify-between gap-x-3 gap-y-2">
      <div class="flex min-w-0 flex-wrap items-center gap-1.5" role="group" aria-label="캘린더 필터">
        <a
          href={homeHref({
            includePosts: !calFilter.includePosts,
            writeFilters: true,
          })}
          class:list={["rounded-full border px-2.5 py-1 text-[12px] font-medium transition", homeCalChipClass(calFilter.includePosts)]}
        >
          글
        </a>
        <a
          href={homeHref({
            impacts: highOn ? calFilter.impacts.filter((i) => i !== "high") : [...calFilter.impacts, "high"],
            writeFilters: true,
          })}
          class:list={["rounded-full border px-2.5 py-1 text-[12px] font-medium transition", homeCalChipClass(highOn)]}
        >
          High
        </a>
        <span class="mx-0.5 h-3 w-px bg-outline-variant/60" aria-hidden="true" />
        {
          HOME_CAL_CATEGORY_OPTIONS.map((cat) => {
            const on = calFilter.categories.includes(cat);
            return (
              <a
                href={homeHref({
                  categories: toggleListMember(calFilter.categories, cat),
                  writeFilters: true,
                })}
                class:list={["rounded-full border px-2.5 py-1 text-[12px] font-medium transition", homeCalChipClass(on)]}
              >
                {homeCalCategoryLabel(cat)}
              </a>
            );
          })
        }
        {
          calFilter.isCustom && (
            <a
              href={filterResetHref}
              class="ml-0.5 text-[12px] font-medium text-on-surface-variant transition hover:text-primary"
            >
              기본
            </a>
          )
        }
      </div>
      <a
        href={`${rootPath}timeline`}
        class="shrink-0 text-[13px] font-medium text-primary transition hover:underline"
      >
        전체 일정
      </a>
    </div>

    <div class="grid grid-cols-1 items-start gap-4 lg:grid-cols-12 lg:gap-5">
      <div class="lg:col-span-9">
        <MonthCalendar
          compact
          viewYear={viewYear}
          viewMonth={viewMonth}
          monthGrid={monthGrid}
          eventsByDay={eventsByDay}
          todayDayKey={todayDayKey}
          selectedDayKey={selectedDayKey}
          todayHref={homeHref({ month: todayMonthStr, day: todayDayKey })}
          prevMonthHref={homeHref({ month: prevMonthStr, day: null })}
          nextMonthHref={homeHref({ month: nextMonthStr, day: null })}
          dayHref={(isoKey) => homeHref({ day: isoKey, month: isoKey.slice(0, 7) })}
          eventsInMonthCount={eventsInCalendarMonth.length}
          filteredTotalCount={homeCalendarEvents.length}
          rootPath={rootPath}
        />
      </div>
      <div class="lg:col-span-3">
      <WeekEventList
        anchorDayKey={selectedDayKey}
        eventsByDay={eventsByDay}
        todayDayKey={todayDayKey}
        rootPath={rootPath}
        dayHref={(isoKey) => homeHref({ day: isoKey, month: isoKey.slice(0, 7) })}
        emptyHint="이번 주에 표시할 일정이 없습니다. 필터를 바꾸거나 전체 일정에서 더 볼 수 있습니다."
      />
      </div>
    </div>
  </section>

  {
    activePost && (
      <section transition:name="dashboard-hero" class="ziin-rise ziin-rise-delay-1 relative z-10 mt-8">
        <HeroCompact
          post={activePost}
          newerHref={newerPostHref}
          olderHref={olderPostHref}
          newerDisabled={!newerPostSlug}
          olderDisabled={!olderPostSlug}
        />
      </section>
    )
  }

  {
    !latestPost && (
      <section class="mt-8 rounded-[20px] border border-outline-variant/50 bg-surface-container-lowest p-6">
        <p class="text-sm text-on-surface-variant">표시할 published post가 아직 없습니다.</p>
        <p class="mt-2 text-xs text-on-surface-variant">
          로컬 개발 중이라면 <code class="rounded bg-surface-container px-1">pnpm dev</code>를 재시작하거나
          <a href={`${rootPath}posts/`} class="text-primary hover:underline">
            분석글 목록
          </a>
          에서 직접 열어보세요.
        </p>
      </section>
    )
  }

  {
    publishedPosts.length > 0 && (
      <section class="ziin-rise ziin-rise-delay-2 relative z-20 mt-8" id="recent-flow" aria-label="최근 흐름 타임라인">
        <details class="group">
          <summary class="mb-3 cursor-pointer list-none marker:content-none [&::-webkit-details-marker]:hidden">
            <div class="flex items-center justify-between gap-3 rounded-[16px] border border-outline-variant/50 bg-surface-container-lowest px-4 py-3.5 shadow-md3-1 transition hover:bg-surface-container-low group-open:rounded-b-none group-open:border-b-0 group-open:shadow-none">
              <div>
                <p class="text-[15px] font-semibold tracking-[-0.02em] text-on-surface">최근 흐름</p>
                <p class="mt-0.5 text-[12px] text-on-surface-variant">가격선 · 이벤트 마커</p>
              </div>
              <span class="text-[13px] font-medium text-primary group-open:hidden">펼치기</span>
              <span class="hidden text-[13px] font-medium text-on-surface-variant group-open:inline">접기</span>
            </div>
          </summary>
          <div class="overflow-hidden rounded-b-[20px] border border-outline-variant/50 border-t-0">
            <DashboardTimelineInteractive
              client:load
              embedded
              key={`${activePost?.id ?? "global"}|${selectedEventMarket}|${selectedEventCategories.join(",")}`}
              allEvents={dashboardEvents}
              windowStart={dashboardWindowStart.toISOString()}
              windowEnd={dashboardWindowEnd.toISOString()}
              todayPct={dashboardTodayPct}
              pricePoints={activeChartPoints}
              themeChartLines={themeChartLines ?? []}
              timelineChartVariant={timelineChartVariant}
              symbol={activePost?.data.symbol}
              market={activePost?.data.market}
              currentPrice={currentPrice}
              priceDataStatusMessage={priceDataStatusMessage}
              rootPath={rootPath}
              filterPathAndQuery={filterPathAndQuery}
              initialMarket={selectedEventMarket}
              initialCategories={selectedEventCategories}
              marketCategoryOptions={marketCategoryOptions}
            />
          </div>
        </details>
      </section>
    )
  }
</Base>
