---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import { calculateScore } from "../../lib/credibility";
import MdIcon from "../../components/ui/MdIcon.astro";

export const prerender = true;

const allPosts = await getCollection("posts");
const posts =
  allPosts.filter((post) => post.data.draft !== true).length > 0
    ? allPosts.filter((post) => post.data.draft !== true)
    : allPosts;
const orderedPosts = [...posts].sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const guidePosts = orderedPosts.filter((post) => post.data.tags.includes("교육"));
const baseUrl = import.meta.env.BASE_URL;
const rootPath = baseUrl.endsWith("/") ? baseUrl : `${baseUrl}/`;
---

<Base
  title="글 목록 | 내 곁에 지인"
  description="출처 기반 증시·매크로 메모와 교육 가이드를 모아 둔 개인 블로그 글 목록."
>
  <section class="mb-6">
    <h1 class="font-sans text-3xl font-semibold tracking-tight text-on-surface">글</h1>
    <p class="mt-1 text-sm text-on-surface-variant">
      시황·테마 메모와 교육용 정리 글을 모아 둡니다. 투자 권유가 아닙니다.
    </p>
  </section>

  {
    guidePosts.length > 0 && (
      <section class="mb-8" aria-label="교육 가이드">
        <div class="mb-3 flex items-center gap-2">
          <MdIcon name="school" size={22} class="text-primary" />
          <h2 class="font-sans text-lg font-semibold tracking-tight text-on-surface">교육 가이드</h2>
        </div>
        <p class="mt-1 text-xs text-on-surface-variant">
          반복해서 쓰는 개념·읽기 틀을 따로 모아 둔 글입니다.
        </p>
        <ul class="mt-3 grid grid-cols-1 gap-2 sm:grid-cols-2">
          {guidePosts.map((post) => {
            const slug = post.id.replace(/\.md$/, "");
            return (
              <li>
                <a
                  href={`${rootPath}posts/${slug}`}
                  class="md-card md-card-filled block px-3.5 py-2.5 text-sm transition"
                >
                  <span class="font-medium text-on-surface">{post.data.title}</span>
                </a>
              </li>
            );
          })}
        </ul>
      </section>
    )
  }

  <section class="grid grid-cols-1 gap-3" aria-label="전체 글">
    <h2 class="font-sans text-lg font-semibold tracking-tight text-on-surface">전체 글</h2>
    {
      orderedPosts.map((post) => {
        const score = calculateScore(post.data.sources);
        const slug = post.id.replace(/\.md$/, "");
        return (
          <a href={`${rootPath}posts/${slug}`} class="md-card block p-4 transition">
            <div class="flex flex-wrap items-center gap-2 text-xs">
              <span class="md-chip !min-h-6 bg-primary-container px-2 text-[11px] text-on-primary-container">
                출처 {score.toFixed(1)}
              </span>
              <span class="text-on-surface-variant">
                {post.data.date.toLocaleDateString("ko-KR")}
              </span>
            </div>
            <h2 class="mt-2 font-sans text-xl font-semibold tracking-tight text-on-surface md:text-2xl">
              {post.data.title}
            </h2>
            <p class="mt-1 text-sm text-on-surface-variant">{post.data.summary}</p>
          </a>
        );
      })
    }
  </section>
</Base>
