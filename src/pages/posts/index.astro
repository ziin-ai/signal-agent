---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import { calculateScore } from "../../lib/credibility";

export const prerender = true;

const allPosts = await getCollection("posts");
const posts =
  allPosts.filter((post) => post.data.draft !== true).length > 0
    ? allPosts.filter((post) => post.data.draft !== true)
    : allPosts;
const orderedPosts = [...posts].sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const guidePosts = orderedPosts.filter((post) => post.data.tags.includes("교육"));
const baseUrl = import.meta.env.BASE_URL;
const rootPath = baseUrl.endsWith("/") ? baseUrl : `${baseUrl}/`;
---

<Base
  title="분석글 아카이브 | 내 곁에 지인"
  description="출처 기반 주식 분석글과 교육 가이드를 최신 발행 순으로 모아보는 아카이브 페이지."
>
  <section class="mb-4">
    <h1 class="font-sans text-3xl font-semibold tracking-tight">분석글</h1>
    <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">
      시황·테마 분석과 함께, 반복해서 쓰는 <strong>교육 가이드</strong>를 공개합니다. 투자 권유가 아닙니다.
    </p>
  </section>

  {
    guidePosts.length > 0 && (
      <section class="mb-6" aria-label="교육 가이드">
        <h2 class="font-sans text-lg font-semibold tracking-tight">교육 가이드</h2>
        <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">
          AdSense·검색 리뷰어와 독자가 먼저 읽기 좋은 정적 해설 글입니다.
        </p>
        <ul class="mt-3 grid grid-cols-1 gap-2 sm:grid-cols-2">
          {guidePosts.map((post) => {
            const slug = post.id.replace(/\.md$/, "");
            return (
              <li>
                <a
                  href={`${rootPath}posts/${slug}`}
                  class="block rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-sm transition hover:border-info/40 dark:border-slate-700 dark:bg-slate-900/80"
                >
                  <span class="font-medium text-slate-800 dark:text-slate-100">{post.data.title}</span>
                </a>
              </li>
            );
          })}
        </ul>
      </section>
    )
  }

  <section class="grid grid-cols-1 gap-3" aria-label="전체 분석글">
    <h2 class="font-sans text-lg font-semibold tracking-tight">전체 글</h2>
      orderedPosts.map((post) => {
        const score = calculateScore(post.data.sources);
        const slug = post.id.replace(/\.md$/, "");
        return (
          <a
            href={`${rootPath}posts/${slug}`}
            class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm transition hover:border-info/40 dark:border-slate-700 dark:bg-slate-900"
          >
            <div class="flex flex-wrap items-center gap-2 text-xs">
              <span class="rounded bg-info/15 px-2 py-0.5 font-semibold text-info">
                출처 점수 {score.toFixed(1)}
              </span>
              <span class="text-slate-500 dark:text-slate-300">
                {post.data.date.toLocaleDateString("ko-KR")}
              </span>
            </div>
            <h2 class="mt-2 font-sans text-2xl font-semibold tracking-tight">{post.data.title}</h2>
            <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">{post.data.summary}</p>
          </a>
        );
      })
    }
  </section>
</Base>
