---
import Base from "../../layouts/Base.astro";
import SourceSidebar from "../../components/post/SourceSidebar.astro";
import MarkdownViewer from "../../components/post/MarkdownViewer.astro";
import { getPostBySlug, renderPostHtml } from "../../lib/content";

export const prerender = false;

const slug = Astro.params.slug ?? "";
const post = await getPostBySlug(slug);
if (!post) {
  return new Response("Not Found", { status: 404, headers: { "Content-Type": "text/plain; charset=utf-8" } });
}
const html = await renderPostHtml(post);
Astro.response.headers.set("Cache-Control", "public, s-maxage=60, stale-while-revalidate=300");
---

<Base
  title={`${post.data.title} | 내 곁에 지인`}
  description={post.data.summary}
  type="article"
>
  <section class="grid grid-cols-1 gap-6 lg:grid-cols-3">
    <article class="prose prose-slate max-w-none rounded-xl border border-slate-300/70 bg-white p-6 dark:prose-invert dark:border-slate-700/70 dark:bg-slate-900 lg:col-span-2">
      <h1 class="mb-2 font-sans text-3xl font-semibold tracking-tight">{post.data.title}</h1>
      <p class="text-sm text-slate-500">{post.data.symbol} · {post.data.date.toLocaleDateString("ko-KR")}</p>
      <div class="mt-3">
        <MarkdownViewer html={html} />
      </div>
    </article>
    <div class="space-y-4 lg:sticky lg:top-4 lg:self-start">
      <SourceSidebar post={post} />
    </div>
  </section>
</Base>
