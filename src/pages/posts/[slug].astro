---
import { getCollection, getEntry, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import SourceSidebar from "../../components/post/SourceSidebar.astro";
import CitationBadge from "../../components/post/CitationBadge.astro";
import MarkdownViewer from "../../components/post/MarkdownViewer.astro";

export const prerender = true;

export async function getStaticPaths() {
  const allPosts = await getCollection("posts");
  const posts =
    allPosts.filter((post) => post.data.draft !== true).length > 0
      ? allPosts.filter((post) => post.data.draft !== true)
      : allPosts;
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.md$/, "") },
  }));
}

const slug = Astro.params.slug ?? "";
const post = await getEntry("posts", slug);
if (!post) {
  throw new Error(`Post not found for slug: ${slug}`);
}
const { Content } = await render(post);
const postBodySectionId = `post-body-${slug.replace(/[^a-zA-Z0-9_-]/g, "-")}`;
---

<Base>
  <section class="grid grid-cols-1 gap-6 lg:grid-cols-3">
    <article class="prose prose-slate max-w-none rounded-xl border border-slate-300/70 bg-white p-6 dark:prose-invert dark:border-slate-700/70 dark:bg-slate-900 lg:col-span-2">
      <h1 class="mb-2 font-sans text-3xl font-semibold tracking-tight">{post.data.title}</h1>
      <p class="text-sm text-slate-500">{post.data.symbol} · {post.data.date.toLocaleDateString("ko-KR")}</p>
      <div class="not-prose mt-3 flex items-center justify-end">
        <button
          type="button"
          class="rounded border border-slate-300 px-2 py-1 text-xs text-slate-600 hover:bg-slate-100 dark:border-slate-600 dark:text-slate-300 dark:hover:bg-slate-800"
          aria-expanded="true"
          aria-controls={postBodySectionId}
          data-post-body-toggle={postBodySectionId}
        >
          상세 내용 숨기기
        </button>
      </div>
      <div id={postBodySectionId} class="mt-3" data-post-body-content>
        <MarkdownViewer Content={Content} components={{ CitationBadge }} />
      </div>
    </article>
    <SourceSidebar post={post} />
  </section>
</Base>

<script is:inline>
  (() => {
    const toggles = document.querySelectorAll("[data-post-body-toggle]");
    toggles.forEach((toggle) => {
      if (!(toggle instanceof HTMLButtonElement)) return;
      const targetId = toggle.dataset.postBodyToggle;
      if (!targetId) return;
      const content = document.getElementById(targetId);
      if (!(content instanceof HTMLElement)) return;
      toggle.addEventListener("click", () => {
        const isHidden = content.classList.toggle("hidden");
        toggle.textContent = isHidden ? "상세 내용 보이기" : "상세 내용 숨기기";
        toggle.setAttribute("aria-expanded", isHidden ? "false" : "true");
      });
    });
  })();
</script>
