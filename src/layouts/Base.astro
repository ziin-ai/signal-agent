---
import { ClientRouter } from "astro:transitions";
import Header from "../components/layout/Header.astro";
import TickerBar from "../components/layout/TickerBar.astro";
import Footer from "../components/layout/Footer.astro";
import { fetchTickerBarQuotes } from "../lib/market";
import "../styles/global.css";
import { getPublicAdsenseClientId } from "../lib/adsense-public-env";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  noindex?: boolean;
}

const {
  title = "내 곁에 지인 | 주식 투자 분석",
  description = "데이터와 출처 기반으로 한국어 주식 투자 인사이트를 제공하는 분석 블로그.",
  image = "/favicon.svg",
  type = "website",
  noindex = false,
} = Astro.props;

const tickerItems = await fetchTickerBarQuotes();

/** GA4 — disabled by default, enable via PUBLIC_GA_MEASUREMENT_ID */
const gaMeasurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID?.trim() || "";

/** Google AdSense — site/account association meta; enable via PUBLIC_ADSENSE_CLIENT_ID (ca-pub-…) */
const adsenseClientId = getPublicAdsenseClientId();
const siteOrigin = Astro.site?.toString().replace(/\/$/, "") || "";
const canonical = siteOrigin
  ? new URL(`${Astro.url.pathname}${Astro.url.search}`, siteOrigin).toString()
  : Astro.url.toString();
const imageUrl = siteOrigin ? new URL(image, siteOrigin).toString() : image;
---

<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {adsenseClientId ? (
      <meta name="google-adsense-account" content={adsenseClientId} />
    ) : null}
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex,nofollow" : "index,follow,max-image-preview:large"} />
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content="내 곁에 지인" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:locale" content="ko_KR" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      name: "내 곁에 지인",
      url: siteOrigin || canonical,
      inLanguage: "ko-KR",
      description,
    })} />
    <ClientRouter />
    {
      gaMeasurementId ? (
        <>
          <script
            async
            src={`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`}
          />
          <script define:vars={{ gaMeasurementId }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              dataLayer.push(arguments);
            }
            gtag("js", new Date());
            gtag("config", gaMeasurementId);
            document.addEventListener("astro:page-load", () => {
              gtag("config", gaMeasurementId, {
                page_path: window.location.pathname + window.location.search,
              });
            });
          </script>
        </>
      ) : null
    }
  </head>
  <body class="antialiased">
    <TickerBar items={tickerItems} transition:persist="ziin-ticker" />
    <Header transition:persist="ziin-header" />
    <main class="mx-auto w-full max-w-6xl px-4 py-6" transition:animate="none">
      <slot />
    </main>
    <Footer transition:persist="ziin-footer" />
    <script is:inline>
      const SCROLL_KEY = "ziin-vt-scroll-y";
      document.addEventListener("astro:before-preparation", (e) => {
        const from = e.from;
        const to = e.to;
        if (!from?.pathname || !to?.pathname) return;
        if (from.pathname === to.pathname) {
          sessionStorage.setItem(SCROLL_KEY, String(window.scrollY));
        } else {
          sessionStorage.removeItem(SCROLL_KEY);
        }
      });
      document.addEventListener("astro:after-swap", () => {
        const raw = sessionStorage.getItem(SCROLL_KEY);
        if (raw === null) return;
        sessionStorage.removeItem(SCROLL_KEY);
        const y = Number(raw);
        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            window.scrollTo(0, Number.isFinite(y) ? y : 0);
          });
        });
      });

      (function dashboardHeroBody() {
        let heroClampRo = null;

        function syncDashboardHeroBodyClamp() {
          const vh = window.visualViewport?.height ?? window.innerHeight;
          const safeBottom = 40;
          const narrow = window.matchMedia("(max-width: 1023px)").matches;

          document.querySelectorAll("[data-dashboard-body-content]").forEach((body) => {
            if (!(body instanceof HTMLElement)) return;
            let toggleBtn = null;
            document.querySelectorAll("[data-dashboard-body-toggle]").forEach((btn) => {
              if (btn instanceof HTMLButtonElement && btn.dataset.dashboardBodyToggle === body.id) {
                toggleBtn = btn;
              }
            });
            if (toggleBtn && toggleBtn.getAttribute("aria-expanded") === "true") return;

            const middle = body.closest("[data-hero-card-middle]");
            const btnRow = body.nextElementSibling;
            if (!middle || !(btnRow instanceof HTMLElement)) return;

            const bodyTop = body.getBoundingClientRect().top;
            /** 본문 아래 버튼까지 뷰포트 안에 들어오도록 허용되는 본문 높이 상한 */
            const viewportCap = Math.floor(vh - bodyTop - btnRow.offsetHeight - safeBottom);

            const slot = middle.clientHeight - btnRow.offsetHeight;
            const slotUse = slot < 48 ? 360 : slot;

            let px = Math.min(slotUse, viewportCap);
            if (narrow) px = Math.min(px, 360);
            px = Math.max(120, Math.min(px, 1200));

            body.style.flex = "";
            body.style.maxHeight = px + "px";
          });

          requestAnimationFrame(() => {
            const rf = document.getElementById("recent-flow");
            if (!rf) return;
            const rfTop = rf.getBoundingClientRect().top;
            /** 메타·타임라인 제목이 함께 보이도록 상단 여유 */
            const peekReserve = 220;
            const targetMaxTop = vh - peekReserve;
            if (rfTop <= targetMaxTop) return;

            const overflow = rfTop - targetMaxTop;
            document.querySelectorAll("[data-dashboard-body-content]").forEach((body) => {
              if (!(body instanceof HTMLElement)) return;
              let toggleBtn = null;
              document.querySelectorAll("[data-dashboard-body-toggle]").forEach((btn) => {
                if (btn instanceof HTMLButtonElement && btn.dataset.dashboardBodyToggle === body.id) {
                  toggleBtn = btn;
                }
              });
              if (toggleBtn && toggleBtn.getAttribute("aria-expanded") === "true") return;

              const cur = parseFloat(body.style.maxHeight);
              if (!Number.isFinite(cur)) return;
              const next = Math.max(120, cur - overflow);
              if (next < cur) body.style.maxHeight = next + "px";
            });
          });
        }

        function attachHeroClampObservers() {
          if (heroClampRo) heroClampRo.disconnect();
          heroClampRo = new ResizeObserver(() => syncDashboardHeroBodyClamp());
          document.querySelectorAll("[data-hero-card-panel]").forEach((el) => heroClampRo.observe(el));
        }

        function initHeroClamp() {
          requestAnimationFrame(() => {
            attachHeroClampObservers();
            syncDashboardHeroBodyClamp();
          });
        }

        document.addEventListener("astro:page-load", initHeroClamp);
        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", initHeroClamp, { once: true });
        } else {
          initHeroClamp();
        }

        let resizeT = 0;
        window.addEventListener("resize", () => {
          clearTimeout(resizeT);
          resizeT = setTimeout(syncDashboardHeroBodyClamp, 120);
        });

        let scrollT = 0;
        window.addEventListener(
          "scroll",
          () => {
            clearTimeout(scrollT);
            scrollT = setTimeout(syncDashboardHeroBodyClamp, 80);
          },
          { passive: true },
        );

        if (window.visualViewport) {
          window.visualViewport.addEventListener("resize", () => syncDashboardHeroBodyClamp());
          window.visualViewport.addEventListener("scroll", () => syncDashboardHeroBodyClamp());
        }

        const w = window;
        if (w.__ziinHeroCardToggleBound) return;
        w.__ziinHeroCardToggleBound = true;
        document.addEventListener("click", (ev) => {
          const el = ev.target;
          if (!(el instanceof Element)) return;
          const toggle = el.closest("[data-dashboard-body-toggle]");
          if (!(toggle instanceof HTMLButtonElement)) return;
          const targetId = toggle.dataset.dashboardBodyToggle;
          if (!targetId) return;
          const content = document.getElementById(targetId);
          if (!(content instanceof HTMLElement)) return;
          const esc = typeof CSS !== "undefined" && CSS.escape ? CSS.escape(targetId) : targetId.replace(/\\/g, "\\\\").replace(/"/g, '\\"');
          const fade = document.querySelector(`[data-dashboard-body-fade="${esc}"]`);
          const isExpanded = toggle.getAttribute("aria-expanded") === "true";
          if (isExpanded) {
            content.style.maxHeight = "";
            content.style.flex = "";
            if (fade instanceof HTMLElement) fade.classList.remove("hidden");
            toggle.textContent = "상세 내용 더보기";
            toggle.setAttribute("aria-expanded", "false");
            requestAnimationFrame(() => syncDashboardHeroBodyClamp());
            return;
          }
          content.style.flex = "0 0 auto";
          content.style.maxHeight = `${content.scrollHeight}px`;
          if (fade instanceof HTMLElement) fade.classList.add("hidden");
          toggle.textContent = "상세 내용 접기";
          toggle.setAttribute("aria-expanded", "true");
        });
      })();
    </script>
  </body>
</html>
