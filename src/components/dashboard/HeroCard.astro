---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import Panel from "../ui/Panel.astro";
import CitationBadge from "../post/CitationBadge.astro";
import MarkdownViewer from "../post/MarkdownViewer.astro";
import PostTrustMeta from "../post/PostTrustMeta.astro";

interface Props {
  post: CollectionEntry<"posts">;
}

const { post } = Astro.props;
const slug = post.id.replace(/\.md$/, "");
const baseUrl = import.meta.env.BASE_URL;
const rootPath = baseUrl.endsWith("/") ? baseUrl : `${baseUrl}/`;
const bodySectionId = `hero-body-${slug}`;
const summary = post.data.summary;
const { Content } = await render(post);
const publishedDate = post.data.date.toLocaleDateString("ko-KR", {
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
});
const naverCode = post.data.market === "KRX" ? post.data.symbol.split(".")[0] : "";
const naverStockUrl =
  naverCode && /^\d{6}$/.test(naverCode) ? `https://finance.naver.com/item/main.naver?code=${naverCode}` : "";
const isUsMarket = ["NASDAQ", "NYSE", "AMEX", "OTC"].includes(post.data.market);
const yahooSymbol = isUsMarket ? post.data.symbol : "";
const yahooFinanceUrl = yahooSymbol
  ? `https://finance.yahoo.com/quote/${encodeURIComponent(yahooSymbol)}`
  : "";

---

<Panel
  class="ziin-rise lg:col-span-2 flex min-h-[400px] flex-col overflow-x-hidden lg:min-h-0"
  data-hero-card-panel
>
  <div class="shrink-0" data-hero-card-header>
    <div class="flex flex-wrap items-center gap-2">
      <span class="md-chip !min-h-7 bg-primary-container px-2.5 text-[11px] font-semibold text-on-primary-container">
        오늘의 분석
      </span>
    </div>

    <h2 class="mt-3 font-sans text-[1.65rem] font-bold leading-snug tracking-[-0.03em] text-on-surface md:text-3xl">
      <a href={`${rootPath}posts/${slug}`} class="transition-colors hover:text-primary">
        {post.data.title}
      </a>
    </h2>
    <p class="mt-2 text-xs text-on-surface-variant">
      <span class="font-mono tabular-nums">{post.data.symbol}</span>
      <span class="mx-2 text-outline-variant">·</span>
      <span>{publishedDate}</span>
      {
        naverStockUrl && (
          <a
            href={naverStockUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="ml-2 inline-flex rounded-md3-sm border border-outline-variant bg-surface-container-low px-1.5 py-0.5 text-[11px] text-primary transition hover:bg-primary-container"
          >
            네이버증권
          </a>
        )
      }
      {
        yahooFinanceUrl && (
          <a
            href={yahooFinanceUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="ml-2 inline-flex rounded-md3-sm border border-outline-variant bg-surface-container-low px-1.5 py-0.5 text-[11px] text-primary transition hover:bg-primary-container"
          >
            Yahoo Finance
          </a>
        )
      }
    </p>
    <PostTrustMeta aiAssisted={post.data.aiAssisted} compact />

    <div class="mt-4">
      <blockquote class="rounded-md3 border-l-[3px] border-primary bg-primary-container/35 px-4 py-3.5 text-[15px] leading-relaxed text-on-surface">
        {summary}
      </blockquote>
    </div>
  </div>

  <div class="mt-3 flex min-h-0 flex-1 flex-col" data-hero-card-middle>
    <div
      id={bodySectionId}
      class="relative min-h-0 max-h-[360px] overflow-hidden opacity-100 transition-[max-height] duration-300 ease-out lg:max-h-none"
      data-dashboard-body-content
    >
      <MarkdownViewer Content={Content} components={{ CitationBadge }} />
      <div
        class="pointer-events-none absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-surface-container-lowest to-transparent dark:from-surface-container-low"
        data-dashboard-body-fade={bodySectionId}
      />
    </div>
    <div class="mt-auto shrink-0 border-t border-outline-variant/70 pt-3">
      <button
        type="button"
        class="w-full rounded-md3-sm px-3 py-2.5 text-sm font-medium text-on-surface-variant transition hover:bg-surface-container hover:text-on-surface"
        aria-expanded="false"
        aria-controls={bodySectionId}
        data-dashboard-body-toggle={bodySectionId}
      >
        상세 내용 더보기
      </button>
    </div>
  </div>
</Panel>
