---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import Panel from "../ui/Panel.astro";
import CitationBadge from "../post/CitationBadge.astro";
import MarkdownViewer from "../post/MarkdownViewer.astro";

interface Props {
  post: CollectionEntry<"posts">;
}

const { post } = Astro.props;
const slug = post.id.replace(/\.md$/, "");
const baseUrl = import.meta.env.BASE_URL;
const rootPath = baseUrl.endsWith("/") ? baseUrl : `${baseUrl}/`;
const bodySectionId = `hero-body-${slug}`;
const bodyPreviewHeight = 420;
const summary = post.data.summary;
const { Content } = await render(post);
const publishedDate = post.data.date.toLocaleDateString("ko-KR", {
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
});
const naverCode = post.data.market === "KRX" ? post.data.symbol.split(".")[0] : "";
const naverStockUrl =
  naverCode && /^\d{6}$/.test(naverCode) ? `https://finance.naver.com/item/main.naver?code=${naverCode}` : "";
const isUsMarket = ["NASDAQ", "NYSE", "AMEX", "OTC"].includes(post.data.market);
const yahooSymbol = isUsMarket ? post.data.symbol : "";
const yahooFinanceUrl = yahooSymbol
  ? `https://finance.yahoo.com/quote/${encodeURIComponent(yahooSymbol)}`
  : "";
---

<Panel class="lg:col-span-2 h-full min-h-[560px]">
  <div class="flex flex-wrap items-center gap-2">
    <span class="rounded-full bg-info/15 px-2.5 py-1 text-xs font-semibold text-info">오늘의 분석</span>
  </div>

  <h2 class="mt-3 font-sans text-2xl font-semibold tracking-tight">
    <a href={`${rootPath}posts/${slug}`} class="hover:text-info">
      {post.data.title}
    </a>
  </h2>
  <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">
    {post.data.symbol}
    <span class="ml-2">{publishedDate}</span>
    {
      naverStockUrl && (
        <a
          href={naverStockUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="ml-2 inline-flex rounded border border-info/40 bg-info/10 px-1.5 py-0.5 text-[11px] text-info hover:bg-info/20"
        >
          네이버증권
        </a>
      )
    }
    {
      yahooFinanceUrl && (
        <a
          href={yahooFinanceUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="ml-2 inline-flex rounded border border-info/40 bg-info/10 px-1.5 py-0.5 text-[11px] text-info hover:bg-info/20"
        >
          Yahoo Finance
        </a>
      )
    }
  </p>

  <div class="mt-3">
    <blockquote class="rounded-lg border-l-4 border-info/70 bg-info/5 px-4 py-3 text-[15px] leading-relaxed text-slate-700 dark:border-info/60 dark:bg-info/10 dark:text-slate-200">
      {summary}
    </blockquote>
  </div>

  <div
    id={bodySectionId}
    class="relative mt-2 overflow-hidden opacity-100 transition-all duration-300 ease-out"
    style={`max-height:${bodyPreviewHeight}px;`}
    data-dashboard-body-content
    data-dashboard-body-preview-height={String(bodyPreviewHeight)}
  >
    <MarkdownViewer Content={Content} components={{ CitationBadge }} />
    <div
      class="pointer-events-none absolute inset-x-0 bottom-0 h-20 bg-gradient-to-t from-white to-transparent dark:from-slate-900"
      data-dashboard-body-fade={bodySectionId}
    />
  </div>
  <div class="mt-4 border-t border-slate-200/80 pt-3 dark:border-slate-700/80">
    <button
      type="button"
      class="w-full rounded-md px-3 py-2 text-sm font-medium text-slate-500 transition hover:bg-slate-100/70 hover:text-slate-700 dark:text-slate-400 dark:hover:bg-slate-800/70 dark:hover:text-slate-200"
      aria-expanded="false"
      aria-controls={bodySectionId}
      data-dashboard-body-toggle={bodySectionId}
    >
      상세 내용 더보기
    </button>
  </div>
</Panel>

<script is:inline>
  (() => {
    const toggles = document.querySelectorAll("[data-dashboard-body-toggle]");
    toggles.forEach((toggle) => {
      if (!(toggle instanceof HTMLButtonElement)) return;
      const targetId = toggle.dataset.dashboardBodyToggle;
      if (!targetId) return;
      const content = document.getElementById(targetId);
      if (!(content instanceof HTMLElement)) return;
      const fade = document.querySelector(`[data-dashboard-body-fade="${targetId}"]`);
      const previewHeight = Number(content.dataset.dashboardBodyPreviewHeight || "220");
      toggle.addEventListener("click", () => {
        const isExpanded = toggle.getAttribute("aria-expanded") === "true";
        if (isExpanded) {
          content.style.maxHeight = `${previewHeight}px`;
          if (fade instanceof HTMLElement) fade.classList.remove("hidden");
          toggle.textContent = "상세 내용 더보기";
          toggle.setAttribute("aria-expanded", "false");
          return;
        }
        content.style.maxHeight = `${content.scrollHeight}px`;
        if (fade instanceof HTMLElement) fade.classList.add("hidden");
        toggle.textContent = "상세 내용 접기";
        toggle.setAttribute("aria-expanded", "true");
      });
    });
  })();
</script>
