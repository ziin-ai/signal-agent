---
import Panel from "../ui/Panel.astro";
import type { CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"posts">;
}

const { post } = Astro.props;

const sources = [...post.data.sources].sort((a, b) => b.date.getTime() - a.date.getTime());

function extractYoutubeId(url: string): string | undefined {
  try {
    const parsed = new URL(url);
    if (parsed.hostname.includes("youtube.com")) {
      const id = parsed.searchParams.get("v");
      return id ?? undefined;
    }
    if (parsed.hostname === "youtu.be") {
      const id = parsed.pathname.replace("/", "").trim();
      return id || undefined;
    }
    return undefined;
  } catch {
    return undefined;
  }
}
function tierLabel(tier: number) {
  if (tier === 0) return "탐색";
  if (tier === 1) return "핵심";
  if (tier === 2) return "보강";
  if (tier === 3) return "참고";
  return "기타";
}
---

<div class="ziin-rise ziin-rise-delay-1 lg:sticky lg:top-4 lg:self-start">
  <Panel title="관련정보" titleClass="!text-[11px] uppercase tracking-[0.08em]" variant="soft" class="flex flex-col">
    <div id="post-source-sidebar" class="mt-3 space-y-2 text-[11px]">
      {sources.length === 0 ? (
        <div class="rounded-md3-sm border border-dashed border-outline-variant bg-surface px-2 py-3 text-[10px] text-on-surface-variant">
          표시할 source 메타데이터가 없습니다.
        </div>
      ) : (
        sources.map((source) => (
          source.type === "youtube" ? (
            <article
              class="rounded-md3 border border-outline-variant/80 bg-surface-container-lowest px-3 py-2.5"
              data-source-tier={source.tier}
            >
              <div class="flex flex-wrap items-center gap-1.5 text-[9px]">
                <span class="rounded-md3-sm bg-primary-container px-1.5 py-0.5 font-semibold text-on-primary-container">
                  {tierLabel(source.tier)}
                </span>
                <span class="rounded-md3-sm bg-surface-container px-1.5 py-0.5 text-on-surface-variant">
                  youtube
                </span>
                <span class="text-on-surface-variant">
                  {source.date.toLocaleDateString("ko-KR")}
                </span>
              </div>
              {extractYoutubeId(source.url) ? (
                <>
                  <div class="mt-2 aspect-video overflow-hidden rounded-md3-sm border border-outline-variant bg-black">
                    <iframe
                      src={`https://www.youtube.com/embed/${extractYoutubeId(source.url)}`}
                      title={`${source.title} embed`}
                      loading="lazy"
                      class="h-full w-full"
                      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                      referrerpolicy="strict-origin-when-cross-origin"
                      allowfullscreen
                    />
                  </div>
                  <div class="mt-1.5 flex items-center gap-3 text-[9px]">
                    <a
                      href={source.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex font-medium text-primary hover:underline"
                    >
                      YouTube 원본 열기
                    </a>
                  </div>
                </>
              ) : (
                <p class="mt-1 text-[10px] text-warning">
                  유효한 YouTube URL이 아니어서 임베드를 표시하지 못했습니다.
                </p>
              )}
            </article>
          ) : (
            <article
              class="rounded-md3 border border-outline-variant/80 bg-surface-container-lowest px-3 py-2.5 transition hover:border-primary/30"
              data-source-tier={source.tier}
            >
              <div class="flex flex-wrap items-center gap-1.5 text-[9px]">
                <span class="rounded-md3-sm bg-primary-container px-1.5 py-0.5 font-semibold text-on-primary-container">
                  {tierLabel(source.tier)}
                </span>
                <span class="rounded-md3-sm bg-surface-container px-1.5 py-0.5 text-on-surface-variant">
                  {source.type}
                </span>
                <span class="text-on-surface-variant">
                  {source.date.toLocaleDateString("ko-KR")}
                </span>
              </div>
              <a
                href={source.url}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-1.5 block text-[12px] font-semibold leading-snug text-primary hover:underline"
                title={source.title}
              >
                {source.title}
              </a>
              <p class="mt-1 line-clamp-2 text-[10px] leading-relaxed text-on-surface-variant">
                {source.excerpt}
              </p>
            </article>
          )
        ))
      )}
    </div>
  </Panel>
</div>
