---
import type { CollectionEntry } from "astro:content";
import PostTrustMeta from "../post/PostTrustMeta.astro";

interface Props {
  post: CollectionEntry<"posts">;
  newerHref?: string;
  olderHref?: string;
  newerDisabled?: boolean;
  olderDisabled?: boolean;
}

const { post, newerHref = "#", olderHref = "#", newerDisabled = true, olderDisabled = true } =
  Astro.props;
const slug = post.id.replace(/\.md$/, "");
const baseUrl = import.meta.env.BASE_URL;
const rootPath = baseUrl.endsWith("/") ? baseUrl : `${baseUrl}/`;
const publishedDate = post.data.date.toLocaleDateString("ko-KR", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<article
  class="rounded-[20px] border border-outline-variant/50 bg-surface-container-lowest px-5 py-5 shadow-md3-1 sm:px-6 sm:py-6"
  aria-label="오늘의 글"
>
  <p class="text-[12px] font-medium text-on-surface-variant">
    오늘의 글
    <span class="mx-1.5 text-outline-variant">·</span>
    <span class="font-mono tabular-nums">{post.data.symbol}</span>
    <span class="mx-1.5 text-outline-variant">·</span>
    {publishedDate}
  </p>

  <h2 class="mt-2.5 max-w-3xl font-sans text-[1.35rem] font-semibold leading-snug tracking-[-0.03em] text-on-surface md:text-[1.65rem]">
    <a href={`${rootPath}posts/${slug}`} class="transition-colors hover:text-primary">
      {post.data.title}
    </a>
  </h2>

  <PostTrustMeta aiAssisted={post.data.aiAssisted} compact />

  <p class="mt-3 max-w-2xl text-[15px] leading-relaxed text-on-surface-variant">
    {post.data.summary}
  </p>

  <div class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-2">
    <a href={`${rootPath}posts/${slug}`} class="md-btn md-btn-filled !min-h-9 px-5 text-sm">
      본문 읽기
    </a>
    <a
      href={`${rootPath}dashboard/${slug}`}
      class="text-[13px] font-medium text-primary transition hover:underline"
    >
      대시보드
    </a>
    <div class="ml-auto flex items-center gap-3 text-[12px] text-on-surface-variant">
      <a
        href={newerHref}
        class={newerDisabled ? "pointer-events-none opacity-35" : "hover:text-primary"}
      >
        더 최신
      </a>
      <span class="text-outline-variant" aria-hidden="true">/</span>
      <a
        href={olderHref}
        class={olderDisabled ? "pointer-events-none opacity-35" : "hover:text-primary"}
      >
        이전
      </a>
    </div>
  </div>
</article>
