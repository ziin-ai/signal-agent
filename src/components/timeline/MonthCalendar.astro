---
import type { TimelineEvent } from "../../lib/timeline";
import type { MonthGridDay } from "../../lib/calendar-grid";
import {
  kindBadgeClass,
  kindShortLabel,
  kindSurfaceClass,
} from "../../lib/timeline-kind-styles";

interface Props {
  viewYear: number;
  viewMonth: number;
  monthGrid: MonthGridDay[];
  eventsByDay: Map<string, TimelineEvent[]>;
  todayDayKey: string;
  selectedDayKey?: string;
  todayHref: string;
  prevMonthHref: string;
  nextMonthHref: string;
  /** 날짜 칸(숫자) 클릭 시. 없으면 선택 UI 없음 */
  dayHref?: (isoKey: string) => string;
  eventsInMonthCount: number;
  filteredTotalCount: number;
  rootPath: string;
  /**
   * compact: 홈 — 칸당 제목 3개 + 더보기.
   * full: 타임라인 — 칸당 제목 5개.
   */
  compact?: boolean;
}

const {
  viewYear,
  viewMonth,
  monthGrid,
  eventsByDay,
  todayDayKey,
  selectedDayKey,
  todayHref,
  prevMonthHref,
  nextMonthHref,
  dayHref,
  eventsInMonthCount,
  filteredTotalCount,
  rootPath,
  compact = false,
} = Astro.props;

const weekdayLabels = ["일", "월", "화", "수", "목", "금", "토"];
const monthTitle = new Date(viewYear, viewMonth - 1, 1).toLocaleDateString("ko-KR", {
  year: "numeric",
  month: "long",
});

function withBase(href: string): string {
  if (!href.startsWith("/")) return href;
  return `${rootPath}${href.slice(1)}`;
}

const cellMin = compact
  ? "min-h-[128px] sm:min-h-[144px] lg:min-h-[156px]"
  : "min-h-[140px] sm:min-h-[156px]";
const maxShow = compact ? 3 : 5;
---

<div class="overflow-hidden rounded-[20px] border border-outline-variant/50 bg-surface-container-lowest shadow-md3-1">
  <div class="flex items-center gap-3 px-4 py-3.5 sm:px-5">
    <h2 class="min-w-0 flex-1 truncate text-[1.35rem] font-semibold tracking-[-0.03em] text-on-surface sm:text-[1.5rem]">
      {monthTitle}
    </h2>
    <div class="flex shrink-0 items-center gap-0.5">
      <a
        href={prevMonthHref}
        class="flex h-8 w-8 items-center justify-center rounded-full text-lg text-on-surface-variant transition hover:bg-surface-container"
        aria-label="이전 달"
      >
        ‹
      </a>
      <a
        href={nextMonthHref}
        class="flex h-8 w-8 items-center justify-center rounded-full text-lg text-on-surface-variant transition hover:bg-surface-container"
        aria-label="다음 달"
      >
        ›
      </a>
      <a
        href={todayHref}
        class="ml-1 rounded-full px-3 py-1.5 text-[13px] font-medium text-primary transition hover:bg-primary/8"
      >
        오늘
      </a>
    </div>
  </div>

  <div
    class="grid grid-cols-7 border-y border-outline-variant/40 px-1 text-center text-[11px] font-medium text-on-surface-variant/80"
  >
    {
      weekdayLabels.map((w) => (
        <div class="py-2">{w}</div>
      ))
    }
  </div>

  <div class="grid grid-cols-7 gap-px bg-outline-variant/35">
    {
      monthGrid.map((cell) => {
        const dayEvents = eventsByDay.get(cell.isoKey) ?? [];
        const shown = dayEvents.slice(0, maxShow);
        const more = Math.max(0, dayEvents.length - shown.length);
        const isToday = cell.isoKey === todayDayKey;
        const isSelected = selectedDayKey === cell.isoKey;
        const dayLink = dayHref?.(cell.isoKey);
        const dayClass = [
          `flex ${cellMin} flex-col bg-surface-container-lowest p-1.5 sm:p-2 transition-colors`,
          !cell.inMonth && "bg-surface-container-low/50",
          isSelected && "bg-primary/[0.07]",
        ]
          .filter(Boolean)
          .join(" ");

        return (
          <div class={dayClass}>
            <div class="flex shrink-0 justify-start">
              {dayLink ? (
                <a
                  href={dayLink}
                  class:list={[
                    "inline-flex h-7 min-w-[1.75rem] items-center justify-center rounded-full text-[13px] tabular-nums transition",
                    isToday && "bg-primary font-semibold text-on-primary",
                    !isToday && isSelected && "font-semibold text-primary",
                    !isToday && !isSelected && cell.inMonth && "text-on-surface hover:bg-surface-container",
                    !isToday && !isSelected && !cell.inMonth && "text-on-surface-variant/55 hover:bg-surface-container",
                  ]}
                  aria-current={isSelected ? "date" : undefined}
                  aria-label={`${cell.isoKey} 일정 목록`}
                  title="이 날짜가 속한 주 보기"
                >
                  {cell.day}
                </a>
              ) : (
                <span
                  class:list={[
                    "inline-flex h-7 min-w-[1.75rem] items-center justify-center rounded-full text-[13px] tabular-nums",
                    isToday && "bg-primary font-semibold text-on-primary",
                    !isToday && isSelected && "font-semibold text-primary",
                    !isToday && !isSelected && cell.inMonth && "text-on-surface",
                    !isToday && !isSelected && !cell.inMonth && "text-on-surface-variant/55",
                  ]}
                >
                  {cell.day}
                </span>
              )}
            </div>
            <div class="mt-1 min-h-0 flex-1 space-y-1 overflow-hidden">
              {shown.map((ev) => {
                const chipClass = `flex max-w-full items-start gap-1 rounded-md px-1.5 py-1 text-left text-[12px] font-medium leading-snug transition-colors ${kindSurfaceClass(ev.kind)}`;
                const chipInner = (
                  <>
                    <span
                      class:list={[
                        "mt-0.5 inline-flex h-4 shrink-0 items-center rounded px-1 text-[9px] font-bold leading-none",
                        kindBadgeClass(ev.kind),
                      ]}
                    >
                      {kindShortLabel(ev.kind)}
                    </span>
                    <span class="min-w-0 line-clamp-2">{ev.title}</span>
                  </>
                );
                return ev.href ? (
                  <a
                    href={withBase(ev.href)}
                    {...(ev.href.startsWith("http")
                      ? { target: "_blank", rel: "noopener noreferrer" }
                      : {})}
                    class={chipClass}
                    title={`${kindShortLabel(ev.kind)} · ${ev.title}`}
                  >
                    {chipInner}
                  </a>
                ) : (
                  <span class={chipClass} title={`${kindShortLabel(ev.kind)} · ${ev.title}`}>
                    {chipInner}
                  </span>
                );
              })}
              {more > 0 && dayLink ? (
                <a
                  href={dayLink}
                  class="block truncate pl-1 text-[10px] font-medium text-primary hover:underline"
                >
                  +{more}개 더보기
                </a>
              ) : more > 0 ? (
                <p class="truncate pl-1 text-[10px] font-medium text-on-surface-variant">+{more}개</p>
              ) : null}
            </div>
          </div>
        );
      })
    }
  </div>

  <div class="flex flex-wrap items-center justify-between gap-3 border-t border-outline-variant/40 px-4 py-2.5 text-[11px] text-on-surface-variant">
    <div class="flex flex-wrap items-center gap-3">
      <span class="inline-flex items-center gap-1.5">
        <span class={`inline-flex h-4 items-center rounded px-1 text-[9px] font-bold ${kindBadgeClass("post")}`}>
          글
        </span>
        <span>분석글</span>
      </span>
      <span class="inline-flex items-center gap-1.5">
        <span class={`inline-flex h-4 items-center rounded px-1 text-[9px] font-bold ${kindBadgeClass("external_event")}`}>
          이벤트
        </span>
        <span>이벤트</span>
      </span>
      {compact && <span class="text-on-surface-variant/70">제목 → 이동 · 날짜 → 그 주</span>}
    </div>
    {!compact && (
      <p class="tabular-nums">
        {eventsInMonthCount}
        <span class="text-on-surface-variant/70"> / {filteredTotalCount}</span>
      </p>
    )}
    <slot name="footer" />
  </div>
</div>
