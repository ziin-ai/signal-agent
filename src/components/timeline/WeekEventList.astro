---
import type { TimelineEvent } from "../../lib/timeline";
import { parseLocalIsoKey, weekIsoKeysContaining, weekRangeLabel } from "../../lib/calendar-grid";
import {
  kindBadgeClass,
  kindLongLabel,
  kindShortLabel,
  kindSurfaceClass,
} from "../../lib/timeline-kind-styles";

interface Props {
  /** 이 날짜가 속한 주(일~토)를 표시 */
  anchorDayKey: string;
  eventsByDay: Map<string, TimelineEvent[]>;
  todayDayKey: string;
  rootPath: string;
  /** 날짜 헤더 클릭 시 (선택일 동기화) */
  dayHref?: (isoKey: string) => string;
  emptyHint?: string;
}

const {
  anchorDayKey,
  eventsByDay,
  todayDayKey,
  rootPath,
  dayHref,
  emptyHint = "이번 주에 표시할 일정이 없습니다.",
} = Astro.props;

const weekKeys = weekIsoKeysContaining(anchorDayKey);
const rangeLabel = weekRangeLabel(weekKeys);
const weekdayShort = ["일", "월", "화", "수", "목", "금", "토"];

const weekDays = weekKeys.map((isoKey, i) => {
  const date = parseLocalIsoKey(isoKey)!;
  return {
    isoKey,
    weekday: weekdayShort[i]!,
    dayNum: date.getDate(),
    isToday: isoKey === todayDayKey,
    isSelected: isoKey === anchorDayKey,
    events: eventsByDay.get(isoKey) ?? [],
  };
});

const weekEventCount = weekDays.reduce((n, d) => n + d.events.length, 0);

function withBase(href: string): string {
  if (!href.startsWith("/")) return href;
  return `${rootPath}${href.slice(1)}`;
}
---

<aside
  class="flex flex-col rounded-[20px] border border-outline-variant/50 bg-surface-container-lowest p-4 shadow-md3-1 sm:p-5"
  aria-label={`주간 일정 ${rangeLabel}`}
>
  <div class="flex flex-wrap items-start justify-between gap-2">
    <div>
      <p class="text-[12px] font-medium text-on-surface-variant">이번 주</p>
      <p class="mt-0.5 text-[15px] font-semibold tracking-[-0.02em] text-on-surface">{rangeLabel}</p>
      <p class="mt-0.5 text-[11px] tabular-nums text-on-surface-variant/80">
        {weekEventCount === 0 ? "일정 없음" : `${weekEventCount}건`}
      </p>
    </div>
    <div class="flex items-center gap-1.5 pt-0.5">
      <span class={`inline-flex h-4 items-center rounded px-1 text-[9px] font-bold ${kindBadgeClass("post")}`}>
        글
      </span>
      <span class={`inline-flex h-4 items-center rounded px-1 text-[9px] font-bold ${kindBadgeClass("external_event")}`}>
        일정
      </span>
    </div>
  </div>

  {
    weekEventCount === 0 ? (
      <p class="mt-5 text-[13px] leading-relaxed text-on-surface-variant">{emptyHint}</p>
    ) : (
      <div class="mt-3 divide-y divide-outline-variant/35">
        {weekDays.map((day) => {
          const hasEvents = day.events.length > 0;
          return (
            <section
              class:list={[
                "py-2.5 first:pt-1 last:pb-0",
                day.isSelected && "rounded-[12px] bg-primary/[0.06] px-2.5 -mx-1",
              ]}
              aria-label={`${day.weekday} ${day.dayNum}일`}
            >
              <div class="flex items-baseline gap-2">
                {dayHref ? (
                  <a
                    href={dayHref(day.isoKey)}
                    class:list={[
                      "shrink-0 text-[12px] font-semibold tracking-tight",
                      day.isToday ? "text-primary" : "text-on-surface hover:text-primary",
                    ]}
                  >
                    <span class="inline-block w-3.5">{day.weekday}</span>
                    <span class="ml-1 tabular-nums font-medium text-on-surface-variant">{day.dayNum}</span>
                    {day.isToday && <span class="ml-1 text-[10px] font-medium text-primary">오늘</span>}
                  </a>
                ) : (
                  <p
                    class:list={[
                      "shrink-0 text-[12px] font-semibold tracking-tight",
                      day.isToday ? "text-primary" : "text-on-surface",
                    ]}
                  >
                    <span class="inline-block w-3.5">{day.weekday}</span>
                    <span class="ml-1 tabular-nums font-medium text-on-surface-variant">{day.dayNum}</span>
                  </p>
                )}

                {!hasEvents && (
                  <span class="text-[11px] text-on-surface-variant/45">없음</span>
                )}
              </div>

              {hasEvents && (
                <ul class="mt-1.5 space-y-1.5">
                  {day.events.map((ev) => (
                    <li>
                      {ev.href ? (
                        <a
                          href={withBase(ev.href)}
                          class:list={[
                            "flex items-start gap-1.5 rounded-lg px-2 py-1.5 transition-colors",
                            kindSurfaceClass(ev.kind),
                          ]}
                          {...(ev.href.startsWith("http")
                            ? { target: "_blank", rel: "noopener noreferrer" }
                            : {})}
                        >
                          <span
                            class:list={[
                              "mt-0.5 inline-flex h-4 shrink-0 items-center rounded px-1 text-[9px] font-bold leading-none",
                              kindBadgeClass(ev.kind),
                            ]}
                          >
                            {kindShortLabel(ev.kind)}
                          </span>
                          <span class="min-w-0">
                            <span class="block text-[13px] font-semibold leading-snug tracking-[-0.01em]">
                              {ev.title}
                            </span>
                            <span class="mt-0.5 block text-[10px] opacity-80">
                              {kindLongLabel(ev.kind)}
                              {ev.meta?.impact === "high" ? " · High" : ""}
                            </span>
                          </span>
                        </a>
                      ) : (
                        <div class:list={["flex items-start gap-1.5 rounded-lg px-2 py-1.5", kindSurfaceClass(ev.kind)]}>
                          <span
                            class:list={[
                              "mt-0.5 inline-flex h-4 shrink-0 items-center rounded px-1 text-[9px] font-bold leading-none",
                              kindBadgeClass(ev.kind),
                            ]}
                          >
                            {kindShortLabel(ev.kind)}
                          </span>
                          <span class="min-w-0 text-[13px] font-semibold leading-snug">{ev.title}</span>
                        </div>
                      )}
                    </li>
                  ))}
                </ul>
              )}
            </section>
          );
        })}
      </div>
    )
  }
</aside>
