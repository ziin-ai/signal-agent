---
import type { TimelineEvent } from "../../lib/timeline";
import {
  kindBadgeClass,
  kindLongLabel,
  kindShortLabel,
  kindSurfaceClass,
} from "../../lib/timeline-kind-styles";

interface Props {
  dayKey: string;
  events: TimelineEvent[];
  rootPath: string;
  emptyHint?: string;
}

const { dayKey, events, rootPath, emptyHint = "이 날짜에 표시할 일정이 없습니다." } = Astro.props;

const label = (() => {
  const [y, m, d] = dayKey.split("-").map(Number);
  if (!y || !m || !d) return dayKey;
  return new Date(y, m - 1, d).toLocaleDateString("ko-KR", {
    month: "long",
    day: "numeric",
    weekday: "short",
  });
})();

function withBase(href: string): string {
  if (!href.startsWith("/")) return href;
  return `${rootPath}${href.slice(1)}`;
}
---

<aside
  class="flex h-full flex-col rounded-[20px] border border-outline-variant/50 bg-surface-container-lowest p-5 shadow-md3-1 lg:sticky lg:top-20"
  aria-label={`${label} 일정`}
>
  <p class="text-[13px] font-medium text-on-surface-variant">{label}</p>
  <p class="mt-0.5 text-[11px] tabular-nums text-on-surface-variant/80">
    {events.length === 0 ? "일정 없음" : `${events.length}건`}
  </p>

  {
    events.length === 0 ? (
      <p class="mt-6 text-[13px] leading-relaxed text-on-surface-variant">{emptyHint}</p>
    ) : (
      <ul class="mt-4 space-y-2">
        {events.map((ev) => (
          <li>
            {ev.href ? (
              <a
                href={withBase(ev.href)}
                class:list={["flex items-start gap-2 rounded-xl px-3 py-2.5 transition-colors", kindSurfaceClass(ev.kind)]}
                {...(ev.href.startsWith("http") ? { target: "_blank", rel: "noopener noreferrer" } : {})}
              >
                <span
                  class:list={[
                    "mt-0.5 inline-flex h-4 shrink-0 items-center rounded px-1 text-[9px] font-bold leading-none",
                    kindBadgeClass(ev.kind),
                  ]}
                >
                  {kindShortLabel(ev.kind)}
                </span>
                <span class="min-w-0">
                  <span class="block text-[14px] font-semibold leading-snug tracking-[-0.015em]">{ev.title}</span>
                  <span class="mt-0.5 block text-[10px] opacity-80">
                    {kindLongLabel(ev.kind)}
                    {ev.meta?.impact === "high" ? " · High" : ""}
                  </span>
                  {ev.summary && (
                    <span class="mt-1 block line-clamp-2 text-[12px] leading-relaxed opacity-75">{ev.summary}</span>
                  )}
                </span>
              </a>
            ) : (
              <div class:list={["flex items-start gap-2 rounded-xl px-3 py-2.5", kindSurfaceClass(ev.kind)]}>
                <span
                  class:list={[
                    "mt-0.5 inline-flex h-4 shrink-0 items-center rounded px-1 text-[9px] font-bold leading-none",
                    kindBadgeClass(ev.kind),
                  ]}
                >
                  {kindShortLabel(ev.kind)}
                </span>
                <span class="text-[14px] font-semibold leading-snug">{ev.title}</span>
              </div>
            )}
          </li>
        ))}
      </ul>
    )
  }
</aside>
