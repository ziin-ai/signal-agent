---
import type { TimelineEvent } from "../../lib/timeline";

interface Props {
  dayKey: string;
  events: TimelineEvent[];
  rootPath: string;
  emptyHint?: string;
}

const { dayKey, events, rootPath, emptyHint = "이 날짜에 표시할 일정이 없습니다." } = Astro.props;

const label = (() => {
  const [y, m, d] = dayKey.split("-").map(Number);
  if (!y || !m || !d) return dayKey;
  return new Date(y, m - 1, d).toLocaleDateString("ko-KR", {
    month: "long",
    day: "numeric",
    weekday: "short",
  });
})();

function withBase(href: string): string {
  if (!href.startsWith("/")) return href;
  return `${rootPath}${href.slice(1)}`;
}

function kindLabel(kind: string) {
  if (kind === "post") return "분석";
  if (kind === "external_event") return "이벤트";
  return "기타";
}
---

<aside
  class="flex h-full flex-col rounded-[20px] border border-outline-variant/50 bg-surface-container-lowest p-5 shadow-md3-1 lg:sticky lg:top-20"
  aria-label={`${label} 일정`}
>
  <p class="text-[13px] font-medium text-on-surface-variant">{label}</p>
  <p class="mt-0.5 text-[11px] tabular-nums text-on-surface-variant/80">
    {events.length === 0 ? "일정 없음" : `${events.length}건`}
  </p>

  {
    events.length === 0 ? (
      <p class="mt-6 text-[13px] leading-relaxed text-on-surface-variant">{emptyHint}</p>
    ) : (
      <ul class="mt-5 divide-y divide-outline-variant/40">
        {events.map((ev) => (
          <li class="py-3.5 first:pt-0 last:pb-0">
            <p class="text-[11px] text-on-surface-variant">
              {kindLabel(ev.kind)}
              {ev.meta?.impact === "high" && <span class="text-warning"> · High</span>}
            </p>
            <p class="mt-1 text-[15px] font-semibold leading-snug tracking-[-0.015em] text-on-surface">
              {ev.href ? (
                <a
                  href={withBase(ev.href)}
                  class="transition-colors hover:text-primary"
                  {...(ev.href.startsWith("http")
                    ? { target: "_blank", rel: "noopener noreferrer" }
                    : {})}
                >
                  {ev.title}
                </a>
              ) : (
                ev.title
              )}
            </p>
            {ev.summary && (
              <p class="mt-1.5 line-clamp-2 text-[12px] leading-relaxed text-on-surface-variant">
                {ev.summary}
              </p>
            )}
          </li>
        ))}
      </ul>
    )
  }
</aside>
