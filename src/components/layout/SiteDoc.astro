---
interface Props {
  title: string;
  updated?: string;
}

const { title, updated } = Astro.props;
---

<article class="mx-auto max-w-3xl">
  <header class="mb-8 border-b border-outline-variant pb-6">
    <h1 class="font-sans text-3xl font-semibold tracking-tight text-on-surface">
      {title}
    </h1>
    {
      updated ? (
        <p class="mt-2 text-sm text-on-surface-variant">최종 업데이트: {updated}</p>
      ) : null
    }
  </header>
  <div
    class="space-y-6 text-[15px] leading-relaxed text-on-surface-variant [&_a]:font-medium [&_a]:text-primary [&_a]:underline [&_a]:underline-offset-2 [&_h2]:mt-10 [&_h2]:mb-3 [&_h2]:font-sans [&_h2]:text-xl [&_h2]:font-semibold [&_h2]:tracking-tight [&_h2]:text-on-surface [&_h3]:mt-6 [&_h3]:mb-2 [&_h3]:font-sans [&_h3]:text-lg [&_h3]:font-semibold [&_h3]:text-on-surface [&_li]:my-1 [&_ol]:list-decimal [&_ol]:pl-5 [&_p]:my-0 [&_strong]:font-semibold [&_strong]:text-on-surface [&_ul]:list-disc [&_ul]:pl-5"
  >
    <slot />
  </div>
</article>
