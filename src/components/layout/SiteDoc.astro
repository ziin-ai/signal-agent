---
interface Props {
  title: string;
  updated?: string;
}

const { title, updated } = Astro.props;
---

<article class="mx-auto max-w-3xl">
  <header class="mb-8 border-b border-slate-200 pb-6 dark:border-slate-700">
    <h1 class="font-sans text-3xl font-semibold tracking-tight text-slate-900 dark:text-slate-100">
      {title}
    </h1>
    {
      updated ? (
        <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">최종 업데이트: {updated}</p>
      ) : null
    }
  </header>
  <div
    class="space-y-6 text-[15px] leading-relaxed text-slate-700 dark:text-slate-300 [&_a]:font-medium [&_a]:text-info [&_a]:underline [&_a]:underline-offset-2 [&_h2]:mt-10 [&_h2]:mb-3 [&_h2]:font-sans [&_h2]:text-xl [&_h2]:font-semibold [&_h2]:tracking-tight [&_h2]:text-slate-900 [&_h2]:dark:text-slate-100 [&_h3]:mt-6 [&_h3]:mb-2 [&_h3]:font-sans [&_h3]:text-lg [&_h3]:font-semibold [&_h3]:text-slate-900 [&_h3]:dark:text-slate-100 [&_li]:my-1 [&_ol]:list-decimal [&_ol]:pl-5 [&_p]:my-0 [&_strong]:font-semibold [&_strong]:text-slate-900 [&_strong]:dark:text-slate-100 [&_ul]:list-disc [&_ul]:pl-5"
  >
    <slot />
  </div>
</article>
