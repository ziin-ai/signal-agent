---
const baseUrl = import.meta.env.BASE_URL;
const rootPath = baseUrl.endsWith("/") ? baseUrl : `${baseUrl}/`;
const navItems = [
  { href: rootPath, label: "홈" },
  { href: `${rootPath}posts`, label: "글" },
  { href: `${rootPath}timeline`, label: "타임라인" },
  { href: `${rootPath}about`, label: "소개" },
  { href: `${rootPath}contact`, label: "문의" },
];
---

<header class="border-b border-slate-300/60 px-4 py-2.5 dark:border-slate-700/60">
  <div class="mx-auto flex w-full max-w-6xl items-center justify-between gap-4">
    <div class="flex items-center gap-8">
      <a href={rootPath} class="text-[1.85rem] font-sans font-bold tracking-[-0.02em] leading-none">
        <span>지인</span><span class="text-info">.ai</span>
      </a>

      <nav class="hidden items-center gap-6 text-sm font-medium tracking-tight md:flex">
        {
          navItems.map((item) => (
            <a href={item.href} class="text-slate-700 transition hover:text-info dark:text-slate-300">
              {item.label}
            </a>
          ))
        }
      </nav>
    </div>

    <div class="flex items-center gap-2 text-sm">
      <span id="kst-time" class="font-mono text-slate-600 dark:text-slate-300">KST --:--:--</span>
      <span class="rounded-full bg-danger px-2 py-0.5 text-xs font-semibold text-white">LIVE</span>
      <button
        id="mobile-menu-toggle"
        type="button"
        class="inline-flex h-9 w-9 items-center justify-center rounded-md border border-slate-300 text-slate-700 transition hover:bg-slate-100 focus:outline-none focus:ring-2 focus:ring-info/50 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-800 md:hidden"
        aria-label="메뉴 열기"
        aria-controls="mobile-nav"
        aria-expanded="false"
      >
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </div>
  <nav id="mobile-nav" class="mx-auto hidden w-full max-w-6xl pt-2 md:hidden">
    <div class="grid gap-1 rounded-lg border border-slate-300/80 bg-white p-2 dark:border-slate-700/80 dark:bg-slate-900">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="rounded-md px-3 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-100 hover:text-info dark:text-slate-200 dark:hover:bg-slate-800"
          >
            {item.label}
          </a>
        ))
      }
    </div>
  </nav>
</header>

<script is:inline>
  (function () {
    let intervalId = /** @type {ReturnType<typeof setInterval> | undefined} */ (undefined);

    const formatter = new Intl.DateTimeFormat("ko-KR", {
      timeZone: "Asia/Seoul",
      hour: "2-digit",
      minute: "2-digit",
      second: "2-digit",
      hour12: false,
    });

    function updateKstTime() {
      const el = document.getElementById("kst-time");
      if (!el) return;
      try {
        el.textContent = "KST " + formatter.format(new Date());
      } catch {
        el.textContent = "KST " + new Date().toLocaleTimeString("ko-KR", { hour12: false });
      }
    }

    function startClock() {
      updateKstTime();
      if (intervalId !== undefined) clearInterval(intervalId);
      intervalId = setInterval(updateKstTime, 1000);
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", startClock, { once: true });
    } else {
      startClock();
    }

    document.addEventListener("astro:page-load", startClock);
  })();
</script>

<script is:inline>
  (function () {
    function initMobileMenu() {
      const toggle = document.getElementById("mobile-menu-toggle");
      const menu = document.getElementById("mobile-nav");
      if (!(toggle instanceof HTMLButtonElement) || !(menu instanceof HTMLElement)) return;

      toggle.onclick = () => {
        const isExpanded = toggle.getAttribute("aria-expanded") === "true";
        const next = !isExpanded;
        toggle.setAttribute("aria-expanded", String(next));
        menu.classList.toggle("hidden", !next);
      };

      const closeMenu = () => {
        toggle.setAttribute("aria-expanded", "false");
        menu.classList.add("hidden");
      };

      window.matchMedia("(min-width: 768px)").addEventListener("change", (e) => {
        if (e.matches) closeMenu();
      });

      menu.querySelectorAll("a").forEach((a) => {
        a.addEventListener("click", closeMenu);
      });
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initMobileMenu, { once: true });
    } else {
      initMobileMenu();
    }
    document.addEventListener("astro:page-load", initMobileMenu);
  })();
</script>
