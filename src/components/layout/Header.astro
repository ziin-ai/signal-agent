---
import MdIcon from "../ui/MdIcon.astro";

const baseUrl = import.meta.env.BASE_URL;
const rootPath = baseUrl.endsWith("/") ? baseUrl : `${baseUrl}/`;
const navItems = [
  { href: rootPath, label: "홈", icon: "home", title: "월 캘린더 + 오늘 읽을 글" },
  { href: `${rootPath}posts`, label: "글", icon: "article" },
  { href: `${rootPath}timeline`, label: "타임라인", icon: "timeline", title: "종목·필터 전체 일정 허브" },
  { href: `${rootPath}about`, label: "소개", icon: "info" },
  { href: `${rootPath}contact`, label: "문의", icon: "mail" },
];
---

<header class="md-top-app-bar sticky top-0 z-40 px-2 py-1 md:px-4">
  <div class="mx-auto flex w-full max-w-7xl items-center justify-between gap-3 min-h-14">
    <div class="flex min-w-0 items-center gap-1 md:gap-5">
      <a
        href={rootPath}
        class="group inline-flex items-baseline gap-0 rounded-md3-sm px-2 py-1.5 leading-none transition hover:bg-primary/8"
        aria-label="지인.ai 홈"
      >
        <span class="font-sans text-[1.45rem] font-bold tracking-[-0.04em] text-on-surface">지인</span>
        <span class="font-sans text-[1.45rem] font-bold tracking-[-0.04em] text-primary">.ai</span>
        <span class="ml-2 hidden text-[11px] font-medium tracking-wide text-on-surface-variant sm:inline">
          내 곁에
        </span>
      </a>

      <nav class="hidden items-center gap-0.5 md:flex" aria-label="주요 메뉴">
        {
          navItems.map((item) => (
            <a
              href={item.href}
              title={"title" in item ? item.title : undefined}
              class="md-btn-text inline-flex items-center gap-1.5 !min-h-9 rounded-md3-sm px-3 py-2 text-sm font-medium text-on-surface-variant transition hover:bg-primary/8 hover:text-primary"
            >
              <MdIcon name={item.icon} size={18} />
              {item.label}
            </a>
          ))
        }
      </nav>
    </div>

    <div class="flex items-center gap-1.5 text-sm">
      <span
        id="kst-time"
        class="hidden font-mono text-[11px] tabular-nums text-on-surface-variant sm:inline"
      >
        KST --:--:--
      </span>
      <span class="md-chip md-chip-live !min-h-7 px-2.5 text-[11px] font-semibold tracking-wide">
        Live
      </span>
      <button
        id="mobile-menu-toggle"
        type="button"
        class="md-btn-icon md:hidden"
        aria-label="메뉴 열기"
        aria-controls="mobile-nav"
        aria-expanded="false"
      >
        <MdIcon name="menu" size={24} />
      </button>
    </div>
  </div>
  <nav id="mobile-nav" class="mx-auto hidden w-full max-w-7xl pb-2 md:hidden" aria-label="모바일 메뉴">
    <div class="md-surface-container md-shape-md grid gap-0.5 p-2">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            title={"title" in item ? item.title : undefined}
            class="inline-flex items-center gap-3 rounded-md3-sm px-3 py-2.5 text-sm font-medium text-on-surface transition hover:bg-primary/10 hover:text-primary"
          >
            <MdIcon name={item.icon} size={20} />
            {item.label}
          </a>
        ))
      }
    </div>
  </nav>
</header>

<script is:inline>
  (function () {
    let intervalId = /** @type {ReturnType<typeof setInterval> | undefined} */ (undefined);

    const formatter = new Intl.DateTimeFormat("ko-KR", {
      timeZone: "Asia/Seoul",
      hour: "2-digit",
      minute: "2-digit",
      second: "2-digit",
      hour12: false,
    });

    function updateKstTime() {
      const el = document.getElementById("kst-time");
      if (!el) return;
      try {
        el.textContent = "KST " + formatter.format(new Date());
      } catch {
        el.textContent = "KST " + new Date().toLocaleTimeString("ko-KR", { hour12: false });
      }
    }

    function startClock() {
      updateKstTime();
      if (intervalId !== undefined) clearInterval(intervalId);
      intervalId = setInterval(updateKstTime, 1000);
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", startClock, { once: true });
    } else {
      startClock();
    }

    document.addEventListener("astro:page-load", startClock);
  })();
</script>

<script is:inline>
  (function () {
    function initMobileMenu() {
      const toggle = document.getElementById("mobile-menu-toggle");
      const menu = document.getElementById("mobile-nav");
      if (!(toggle instanceof HTMLButtonElement) || !(menu instanceof HTMLElement)) return;

      toggle.onclick = () => {
        const isExpanded = toggle.getAttribute("aria-expanded") === "true";
        const next = !isExpanded;
        toggle.setAttribute("aria-expanded", String(next));
        menu.classList.toggle("hidden", !next);
        const icon = toggle.querySelector(".material-symbols-outlined");
        if (icon) icon.textContent = next ? "close" : "menu";
        toggle.setAttribute("aria-label", next ? "메뉴 닫기" : "메뉴 열기");
      };

      const closeMenu = () => {
        toggle.setAttribute("aria-expanded", "false");
        menu.classList.add("hidden");
        const icon = toggle.querySelector(".material-symbols-outlined");
        if (icon) icon.textContent = "menu";
        toggle.setAttribute("aria-label", "메뉴 열기");
      };

      window.matchMedia("(min-width: 768px)").addEventListener("change", (e) => {
        if (e.matches) closeMenu();
      });

      menu.querySelectorAll("a").forEach((a) => {
        a.addEventListener("click", closeMenu);
      });
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initMobileMenu, { once: true });
    } else {
      initMobileMenu();
    }
    document.addEventListener("astro:page-load", initMobileMenu);
  })();
</script>
