---
const baseUrl = import.meta.env.BASE_URL;
const rootPath = baseUrl.endsWith("/") ? baseUrl : `${baseUrl}/`;
const navItems = [
  { href: rootPath, label: "대시보드" },
  { href: `${rootPath}posts`, label: "분석글" },
  { href: `${rootPath}timeline`, label: "타임라인" },
];
---

<header class="border-b border-slate-300/60 px-4 py-2.5 dark:border-slate-700/60">
  <div class="mx-auto flex w-full max-w-6xl items-center justify-between gap-4">
    <div class="flex items-center gap-8">
      <a href={rootPath} class="text-[1.85rem] font-sans font-bold tracking-[-0.02em] leading-none">
        <span>지인</span><span class="text-info">.ai</span>
      </a>

      <nav class="hidden items-center gap-6 text-sm font-medium tracking-tight md:flex">
        {
          navItems.map((item) => (
            <a href={item.href} class="text-slate-700 transition hover:text-info dark:text-slate-300">
              {item.label}
            </a>
          ))
        }
      </nav>
    </div>

    <div class="flex items-center gap-2 text-sm">
      <span id="kst-time" class="font-mono text-slate-600 dark:text-slate-300">KST --:--:--</span>
      <span class="rounded-full bg-danger px-2 py-0.5 text-xs font-semibold text-white">LIVE</span>
    </div>
  </div>
</header>

<script is:inline>
  const timeEl = document.getElementById("kst-time");
  const formatter = new Intl.DateTimeFormat("ko-KR", {
    timeZone: "Asia/Seoul",
    hour: "2-digit",
    minute: "2-digit",
    second: "2-digit",
    hour12: false,
  });

  const updateKstTime = () => {
    if (!timeEl) return;
    timeEl.textContent = `KST ${formatter.format(new Date())}`;
  };

  updateKstTime();
  setInterval(updateKstTime, 1000);
</script>
