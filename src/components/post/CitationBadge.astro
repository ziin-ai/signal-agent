---
interface Props {
  id: string;
  index?: number;
  title?: string;
}

const { id, index, title } = Astro.props;
const num = index ?? id.replace(/^src-/, "#");
---

<sub class="jiin-cite-group" role="doc-noteref">
  <span class="jiin-cite-item" title={title ?? id}>
    <span class="jiin-cite-mark">
      <span class="jiin-cite-num">{num}</span>
    </span>
  </span>
</sub>
