---
interface Props {
  html?: string;
  Content?: any;
  components?: Record<string, any>;
}

const { html, Content, components = {} } = Astro.props;
---

<article class="markdown-viewer">
  {html ? <Fragment set:html={html} /> : Content ? <Content components={components} /> : null}
</article>

<style>
  :global(.markdown-viewer) {
    color: var(--color-fg);
    line-height: 1.75;
    font-size: 0.98rem;
    word-break: keep-all;
    overflow-wrap: anywhere;
  }

  :global(.markdown-viewer > :first-child) {
    margin-top: 0;
  }

  :global(.markdown-viewer > :last-child) {
    margin-bottom: 0;
  }

  :global(.markdown-viewer h1) {
    margin-top: 1.6rem;
    margin-bottom: 0.7rem;
    font-size: 1.4rem;
    font-weight: 800;
    letter-spacing: -0.015em;
  }

  :global(.markdown-viewer h2) {
    margin-top: 1.4rem;
    margin-bottom: 0.55rem;
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  :global(.markdown-viewer h3) {
    margin-top: 1.2rem;
    margin-bottom: 0.45rem;
    font-size: 1.08rem;
    font-weight: 600;
  }

  :global(.markdown-viewer h4) {
    margin-top: 1rem;
    margin-bottom: 0.4rem;
    font-size: 0.98rem;
    font-weight: 600;
  }

  :global(.markdown-viewer p) {
    margin: 0.55rem 0;
    color: color-mix(in oklab, var(--color-fg) 92%, white 8%);
  }

  :global(.markdown-viewer a) {
    color: var(--color-info);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  :global(.markdown-viewer ul),
  :global(.markdown-viewer ol) {
    margin: 0.65rem 0 0.8rem;
    padding-left: 1.2rem;
  }

  :global(.markdown-viewer ul) {
    list-style: disc;
  }

  :global(.markdown-viewer ol) {
    list-style: decimal;
  }

  :global(.markdown-viewer li) {
    margin: 0.28rem 0;
  }

  :global(.markdown-viewer strong) {
    font-weight: 700;
    color: color-mix(in oklab, var(--color-fg) 96%, white 4%);
  }

  :global(.markdown-viewer code) {
    padding: 0.1rem 0.32rem;
    border-radius: 0.35rem;
    background: color-mix(in oklab, var(--color-fg) 8%, transparent);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
    font-size: 0.86em;
  }

  :global(.markdown-viewer pre) {
    margin: 0.8rem 0 1rem;
    overflow-x: auto;
    border-radius: 0.75rem;
    border: 1px solid color-mix(in oklab, var(--color-fg) 18%, transparent);
    background: color-mix(in oklab, var(--color-fg) 6%, transparent);
    padding: 0.75rem 0.85rem;
  }

  :global(.markdown-viewer pre code) {
    padding: 0;
    border-radius: 0;
    background: transparent;
    font-size: 0.84rem;
    line-height: 1.65;
  }

  :global(.markdown-viewer blockquote) {
    margin: 0.9rem 0;
    border-left: 3px solid var(--color-info);
    padding-left: 0.8rem;
    color: color-mix(in oklab, var(--color-fg) 80%, white 20%);
  }

  :global(.markdown-viewer hr) {
    margin: 1rem 0;
    border: none;
    border-top: 1px solid color-mix(in oklab, var(--color-fg) 16%, transparent);
  }

  :global(.markdown-viewer table) {
    width: 100%;
    margin: 0.75rem 0 1rem;
    border-collapse: collapse;
    font-size: 0.92rem;
  }

  :global(.markdown-viewer th),
  :global(.markdown-viewer td) {
    border: 1px solid color-mix(in oklab, var(--color-fg) 16%, transparent);
    padding: 0.42rem 0.5rem;
    text-align: left;
    vertical-align: top;
  }

  :global(.markdown-viewer th) {
    background: color-mix(in oklab, var(--color-fg) 7%, transparent);
    font-weight: 700;
  }

  :global(.markdown-viewer img) {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 0.8rem 0;
    border-radius: 0.65rem;
  }

  :global(.markdown-viewer iframe) {
    margin-top: 0.8rem;
    width: 100%;
    border: 1px solid color-mix(in oklab, var(--color-fg) 18%, transparent);
    border-radius: 0.75rem;
  }

  :global(.markdown-viewer .jiin-cite-group) {
    display: inline;
    vertical-align: sub;
    font-size: 0.72em;
    line-height: 0;
    white-space: nowrap;
    margin: 0 0.1em;
    font-feature-settings: "tnum" 1, "lnum" 1;
    letter-spacing: 0.01em;
    position: relative;
    top: 0.04em;
  }

  :global(.markdown-viewer .jiin-cite-item) {
    display: inline;
    white-space: nowrap;
  }

  :global(.markdown-viewer .jiin-cite-sep) {
    margin: 0 0.1em;
    color: color-mix(in oklab, var(--color-info) 20%, var(--color-fg));
    font-weight: 500;
    user-select: none;
  }

  :global(.markdown-viewer .jiin-cite-mark) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin: 0;
    min-width: 1.15em;
    padding: 0.08em 0.34em;
    border: 1px solid color-mix(in oklab, var(--color-info) 16%, transparent);
    background: color-mix(in oklab, var(--color-info) 5%, var(--color-bg));
    color: color-mix(in oklab, var(--color-info) 50%, var(--color-fg));
    font: inherit;
    font-size: inherit;
    font-weight: 500;
    line-height: 1.1;
    cursor: pointer;
    border-radius: 0.38em;
    box-shadow: 0 1px 0 color-mix(in oklab, var(--color-info) 4%, transparent);
    transition:
      color 0.18s cubic-bezier(0.25, 0.1, 0.25, 1),
      background 0.18s cubic-bezier(0.25, 0.1, 0.25, 1),
      border-color 0.18s cubic-bezier(0.25, 0.1, 0.25, 1),
      box-shadow 0.18s cubic-bezier(0.25, 0.1, 0.25, 1),
      transform 0.18s cubic-bezier(0.25, 0.1, 0.25, 1);
  }

  :global(.markdown-viewer .jiin-cite-mark:hover) {
    color: color-mix(in oklab, var(--color-info) 65%, var(--color-fg));
    background: color-mix(in oklab, var(--color-info) 9%, var(--color-bg));
    border-color: color-mix(in oklab, var(--color-info) 28%, transparent);
    box-shadow: 0 1px 2px color-mix(in oklab, var(--color-info) 7%, transparent);
    transform: translateY(-0.04em);
  }

  :global(.markdown-viewer .jiin-cite-mark:hover .jiin-cite-num) {
    text-decoration: none;
  }

  :global(.markdown-viewer .jiin-cite-mark:focus-visible) {
    outline: none;
    box-shadow:
      0 0 0 3px color-mix(in oklab, var(--color-info) 18%, transparent),
      0 1px 2px color-mix(in oklab, var(--color-info) 8%, transparent);
  }

  :global(.markdown-viewer .jiin-cite-num) {
    font-variant-numeric: tabular-nums;
    font-size: 0.96em;
  }

  :global(.markdown-viewer .jiin-cite-ext) {
    display: inline-flex;
    align-items: center;
    margin-left: 0.08em;
    padding: 0;
    color: color-mix(in oklab, var(--color-info) 32%, var(--color-fg));
    font-size: 0.82em;
    font-weight: 500;
    text-decoration: none;
    opacity: 0.5;
    vertical-align: baseline;
    transition:
      opacity 0.18s cubic-bezier(0.25, 0.1, 0.25, 1),
      color 0.18s cubic-bezier(0.25, 0.1, 0.25, 1);
  }

  :global(.markdown-viewer .jiin-cite-group:hover .jiin-cite-ext),
  :global(.markdown-viewer .jiin-cite-ext:focus-visible) {
    opacity: 0.78;
    color: color-mix(in oklab, var(--color-info) 55%, var(--color-fg));
  }

  :global(.markdown-viewer .jiin-cite-ext:hover) {
    text-decoration: underline;
    text-underline-offset: 2px;
  }
</style>
