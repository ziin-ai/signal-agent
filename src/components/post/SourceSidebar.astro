---
import type { CollectionEntry } from "astro:content";
import { calculateScore } from "../../lib/credibility";

interface Props {
  post: CollectionEntry<"posts">;
}

const { post } = Astro.props;

function marketLabel(market: string): string {
  const m: Record<string, string> = {
    KRX: "한국 · KRX",
    NASDAQ: "미국 · 나스닥",
    NYSE: "미국 · NYSE",
    AMEX: "미국 · AMEX",
    OTC: "미국 · OTC",
  };
  return m[market] ?? market;
}

function entityGroupLabel(key: string): string {
  const labels: Record<string, string> = {
    company: "기업·주체",
    product: "제품·이슈",
    region: "지역",
    sector: "섹터",
    policy: "정책",
  };
  return labels[key] ?? key;
}

function symbolDisplay(symbol: string): string {
  const u = symbol.trim().toUpperCase();
  if (u === "THEME") return "THEME (시장 지수)";
  return symbol.trim();
}

const score = calculateScore(post.data.sources);
const tiers = post.data.sources.reduce(
  (acc, source) => {
    acc[source.tier] += 1;
    return acc;
  },
  { 0: 0, 1: 0, 2: 0, 3: 0, 4: 0 } as Record<0 | 1 | 2 | 3 | 4, number>,
);
const total = Math.max(1, post.data.sources.length);
const recentSources = [...post.data.sources]
  .sort((a, b) => b.date.getTime() - a.date.getTime())
  .slice(0, 5);

const entityBlocks = Object.entries(post.data.entities ?? {}).filter(([, list]) => list.length > 0);
---

<aside id="post-source-sidebar" class="space-y-4 rounded-xl border border-slate-300/70 bg-white p-4 shadow-sm dark:border-slate-700/70 dark:bg-slate-900">
  <section class="rounded-lg border border-slate-200/80 bg-white/90 p-3 dark:border-slate-600/80 dark:bg-slate-900/80">
    <p class="text-sm font-semibold text-slate-800 dark:text-slate-100">글 정보</p>
    <div class="mt-3 space-y-2.5 text-[13px]">
      <div class="flex flex-col gap-0.5">
        <p class="text-[10px] font-medium uppercase tracking-wide text-slate-500 dark:text-slate-400">발행</p>
        <p class="text-slate-700 dark:text-slate-200">
          {post.data.date.toLocaleDateString("ko-KR", {
            year: "numeric",
            month: "long",
            day: "numeric",
          })}
        </p>
      </div>
      <div class="flex flex-col gap-0.5">
        <p class="text-[10px] font-medium uppercase tracking-wide text-slate-500 dark:text-slate-400">시장</p>
        <p class="text-slate-700 dark:text-slate-200">{marketLabel(post.data.market)}</p>
      </div>
      <div class="flex flex-col gap-0.5">
        <p class="text-[10px] font-medium uppercase tracking-wide text-slate-500 dark:text-slate-400">심볼</p>
        <p class="font-mono text-sm text-slate-800 dark:text-slate-100">{symbolDisplay(post.data.symbol)}</p>
      </div>
      <div class="flex flex-col gap-1.5">
        <p class="text-[10px] font-medium uppercase tracking-wide text-slate-500 dark:text-slate-400">태그</p>
        <div class="flex flex-wrap gap-1">
          {
            post.data.tags.map((tag) => (
              <span class="rounded-full bg-slate-100 px-2 py-0.5 text-[11px] text-slate-700 dark:bg-slate-800 dark:text-slate-200">
                {tag}
              </span>
            ))
          }
        </div>
      </div>
      {
        entityBlocks.length > 0 ? (
          <div class="border-t border-slate-200/90 pt-2.5 dark:border-slate-600/80">
            <p class="text-[10px] font-medium uppercase tracking-wide text-slate-500 dark:text-slate-400">엔티티</p>
            <div class="mt-2 space-y-2">
              {entityBlocks.map(([key, items]) => (
                <div>
                  <p class="text-[11px] font-medium text-slate-600 dark:text-slate-300">{entityGroupLabel(key)}</p>
                  <ul class="mt-1 list-inside list-disc space-y-0.5 text-[12px] text-slate-700 dark:text-slate-200">
                    {items.map((name) => (
                      <li>{name}</li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </div>
        ) : null
      }
      <div class="border-t border-slate-200/90 pt-2.5 text-[11px] text-slate-500 dark:border-slate-600/80 dark:text-slate-400">
        {post.data.aiAssisted ? (
          <span class="rounded bg-amber-50 px-1.5 py-0.5 text-amber-800 dark:bg-amber-950/50 dark:text-amber-200">
            작성에 AI 보조 사용
          </span>
        ) : (
          <span>작성: 직접</span>
        )}
      </div>
    </div>
  </section>

  <section class="rounded-lg bg-secondary/35 p-3">
    <p class="text-xs text-slate-500 dark:text-slate-300">출처 점수</p>
    <p class="mt-1 text-2xl font-semibold">{score.toFixed(2)} / 10</p>
  </section>

  <section>
    <p class="mb-2 text-sm font-semibold">Tier 분포</p>
    <div class="h-2 overflow-hidden rounded-full bg-slate-200 dark:bg-slate-700">
      <div class="flex h-full">
        <div class="bg-info" style={`width:${(tiers[1] / total) * 100}%`} />
        <div class="bg-success" style={`width:${(tiers[2] / total) * 100}%`} />
        <div class="bg-warning" style={`width:${(tiers[3] / total) * 100}%`} />
        <div class="bg-slate-500" style={`width:${(tiers[4] / total) * 100}%`} />
        <div class="bg-danger" style={`width:${(tiers[0] / total) * 100}%`} />
      </div>
    </div>
  </section>

  <section>
    <p class="mb-2 text-sm font-semibold">최근 인용 출처</p>
    <ul class="space-y-2 text-sm" data-source-list>
      {
        recentSources.map((source) => (
          <li class="rounded bg-secondary/35 px-2 py-2" data-source-tier={source.tier}>
            <a href={source.url} target="_blank" class="line-clamp-1 hover:text-info">
              [{source.id}] {source.title}
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</aside>
