---
interface Props {
  name: string;
  filled?: boolean;
  class?: string;
  /** Optical size hint for variable font (20–48) */
  size?: number;
  label?: string;
}

const { name, filled = false, class: className = "", size = 24, label } = Astro.props;
const style = `font-size:${size}px;font-variation-settings:'FILL' ${filled ? 1 : 0},'wght' 400,'GRAD' 0,'opsz' ${size}`;
---

{
  label ? (
    <span class:list={["material-symbols-outlined", className]} style={style} role="img" aria-label={label}>
      {name}
    </span>
  ) : (
    <span class:list={["material-symbols-outlined", className]} style={style} aria-hidden="true">
      {name}
    </span>
  )
}
