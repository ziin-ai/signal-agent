---
interface Props {
  label: string;
  value: string;
  tone?: "default" | "success" | "danger" | "warning" | "info";
}

const { label, value, tone = "default" } = Astro.props;
const toneClass =
  tone === "success"
    ? "text-success"
    : tone === "danger"
      ? "text-danger"
      : tone === "warning"
        ? "text-warning"
        : tone === "info"
          ? "text-info"
          : "text-slate-800 dark:text-slate-100";
---

<article class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-900">
  <p class="text-xs text-slate-500 dark:text-slate-300">{label}</p>
  <p class={`mt-1 text-2xl font-semibold ${toneClass}`}>{value}</p>
  <slot />
</article>
