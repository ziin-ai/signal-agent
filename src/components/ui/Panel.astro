---
interface Props {
  title?: string;
  titleClass?: string;
  class?: string;
  variant?: "default" | "info" | "soft";
}

const { title, titleClass = "", class: className = "", variant = "default" } = Astro.props;
const variantClass =
  variant === "info"
    ? "md-card border-primary/20 bg-primary-container/40"
    : variant === "soft"
      ? "md-card md-card-filled"
      : "md-card";
---

<section class={`${variantClass} p-5 ${className}`}>
  {title && (
    <h2 class={`font-sans text-sm font-semibold tracking-wide text-on-surface-variant ${titleClass}`}>
      {title}
    </h2>
  )}
  <slot />
</section>
